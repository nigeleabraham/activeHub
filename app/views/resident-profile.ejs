<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My profile | <%= siteTitle %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
</head>
<body class="bg-light">
    <%- include('partials/cookie-banner') %>
    <div class="bg-white border-bottom">
        <div class="container py-3 d-md-flex justify-content-between align-items-center">
            <a href="/"><% if (hasLogo) { %><img src="/site-logo" alt="<%= siteTitle %> logo" style="height: 2rem; width: auto; max-width: 12rem;"><% } else { %><%= siteTitle %><% } %></a>
            <%- include('partials/navigation') %>
        </div>
    </div>
    <main class="container py-5">
        <p><a href="/">&larr; Back to home</a></p>
        <h1 class="h2">My profile</h1>
        <p>Update your name and email address. For booking credit and requests, visit <a href="/credits-and-refunds">Credits and refunds</a>.</p>
        <section class="bg-white border rounded shadow-sm p-4" aria-labelledby="my-details">
            <h2 id="my-details" class="h4 mb-3">My details</h2>
            <% if (saved) { %><div class="alert alert-success" role="status">Your details have been saved.</div><% } %>
            <% if (error) { %><div class="alert alert-danger" role="alert"><%= error === 'duplicate-email' ? 'That email address is already used by another profile.' : 'Please enter a name and a valid email address.' %></div><% } %>
            <form method="POST" action="/profile">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="profile-name">Name</label>
                        <input class="form-control" id="profile-name" name="name" type="text" maxlength="120" required autocomplete="name" value="<%= profile.name %>">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="profile-email">Email</label>
                        <input class="form-control" id="profile-email" name="email" type="email" maxlength="254" required autocomplete="email" value="<%= profile.email %>">
                    </div>
                </div>
                <button class="btn btn-primary" type="submit">Save changes</button>
            </form>
        </section>
    </main>
</body>
</html>
