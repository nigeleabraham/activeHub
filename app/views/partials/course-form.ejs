<% const customDescription = course && (course.description_custom ??
    (!course.description_sport_guid || Object.keys(course.description_overrides || {}).length > 0 || (course.description_sections || []).length > 0));
const standardAvailable = sports.some(sport => (course?.sport_guids || []).includes(sport.guid) && sport.course_description_text?.trim());
const standardMode = standardAvailable && (!course || !customDescription); %>
<fieldset class="admin-form-section">
    <legend class="admin-form-section-title">1. Course details</legend>
    <div class="form-group">
        <label for="<%= prefix %>-name">Course name</label>
        <input class="form-control" id="<%= prefix %>-name" name="name" maxlength="160" value="<%= course?.name || '' %>" required>
    </div>
    <fieldset class="form-group mb-0">
        <legend class="h6">Sport (select at least one)</legend>
        <% if (!sports.length) { %><p class="text-warning">No sports are available. An administrator must add one before this course can be saved.</p><% } %>
        <div class="row">
        <% sports.forEach(sport => { %>
            <div class="col-6 mb-1">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="<%= prefix %>-sport_guids-<%= sport.guid %>" name="sport_guids" value="<%= sport.guid %>"<%= (course?.sport_guids || []).includes(sport.guid) ? ' checked' : '' %>>
                <label class="form-check-label" for="<%= prefix %>-sport_guids-<%= sport.guid %>"><%= sport.name %></label>
            </div>
            </div>
        <% }); %>
        </div>
    </fieldset>
</fieldset>

<fieldset class="admin-form-section" data-description-editor>
    <legend class="admin-form-section-title">2. Description</legend>
    <fieldset class="form-group">
        <legend class="h6">How do you want to describe this course?</legend>
        <div class="form-check mb-2">
            <input class="form-check-input" type="radio" id="<%= prefix %>-mode-standard" name="description_mode" value="standard" data-description-mode aria-describedby="<%= prefix %>-standard-availability"<%= standardMode ? ' checked' : '' %><%= standardAvailable ? '' : ' disabled' %>>
            <label class="form-check-label<%= standardAvailable ? '' : ' text-muted' %>" for="<%= prefix %>-mode-standard" data-description-standard-label>Use a sport's standard description <span class="text-muted">(recommended)</span></label>
            <small id="<%= prefix %>-standard-availability" class="form-text text-muted mt-0" data-description-availability<%= standardAvailable ? ' hidden' : '' %>>Unavailable: select a sport with a standard description, or customise this course's description.</small>
            <small class="form-text text-muted mt-0">The whole description updates automatically when the sport's standard description changes.</small>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" id="<%= prefix %>-mode-own" name="description_mode" value="own" data-description-mode<%= standardMode ? '' : ' checked' %>>
            <label class="form-check-label" for="<%= prefix %>-mode-own">Customise this course's description</label>
        </div>
    </fieldset>

    <div data-description-standard>
        <div class="form-group">
            <label for="<%= prefix %>-source">Standard description from</label>
            <select class="form-control" id="<%= prefix %>-source" name="description_sport_guid" data-description-source>
                <option value="">Choose a sport</option>
                <% sports.forEach(sport => { %><option value="<%= sport.guid %>" <%= course?.description_sport_guid === sport.guid ? 'selected' : '' %>><%= sport.name %></option><% }); %>
            </select>
            <small class="form-text text-muted" data-description-source-help>Only sports ticked above can be chosen.</small>
        </div>
        <input type="hidden" name="description_overrides" value="{}">
        <input type="hidden" name="description_sections" value="[]">
        <% sports.forEach(sport => { %>
            <template data-description-defaults="<%= sport.guid %>"><%= sport.course_description_text || '' %></template>
        <% }); %>
    </div>

    <div class="form-group" data-description-own>
        <label for="<%= prefix %>-description">Description</label>
        <textarea class="form-control" id="<%= prefix %>-description" name="description" rows="10" maxlength="1020000"><%= course?.description_text ?? course?.description ?? '' %></textarea>
        <small class="form-text text-muted" data-description-state></small>
        <button type="button" class="btn btn-link btn-sm p-0 mt-2" data-description-reset>Reset to sport description</button>
    </div>

    <div class="mb-2" data-formatting-help>
        <p class="small font-weight-bold mb-1">Formatting help</p>
        <ul class="list-unstyled d-flex flex-wrap small text-muted mb-0" style="column-gap: 1.5rem; row-gap: 0.25rem;">
            <li>&lt;bold&gt;text&lt;/bold&gt; for <strong>bold</strong></li>
            <li>&lt;ul&gt;text&lt;/ul&gt; for <u>underline</u></li>
            <li>&lt;bullet&gt;text&lt;/bullet&gt; for each bullet point</li>
            <li>&lt;email&gt;name@example.com&lt;/email&gt; for a clickable email address</li>
            <li>Other HTML is displayed as text.</li>
        </ul>
    </div>
    <details data-description-preview>
        <summary class="small">Preview as customers see it</summary>
        <div class="bg-white border rounded p-3 mt-2" data-description-preview-body></div>
    </details>
</fieldset>
<p class="small text-muted">These details are shared by all course runs. Add locations, sessions, prices and capacities after saving the course.</p>
