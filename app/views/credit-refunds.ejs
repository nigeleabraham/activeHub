<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.historyPage ? 'Refund history' : 'Refund requests' %> | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <%- include('partials/booking-flow-styles') %>
</head>
<body class="bg-light">
    <%- include('partials/navigation') %>
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1"><%= locals.historyPage ? 'Refund history' : 'Refund requests' %></h1>
                <p class="text-muted"><%= locals.historyPage ? 'Search completed refund requests.' : 'Requests to transfer refundable booking credit to a bank account.' %></p>
            </div>
        </header>
        <% if (!locals.historyPage) { %>
        <p>Action the bank transfer outside ActiveHub, then mark the request as done to record completion and deduct the current remaining credit. Check the remaining amount before transferring: it may decrease if credit is spent; fully spent requests close automatically. Refund requests cannot be declined.</p>
        <p><a href="/admin/credit-refunds/history?from_queue=1">Search refund history</a></p>
        <% } else if (locals.fromQueue) { %><p><a href="/admin/credit-refunds">Back to pending refund requests</a></p><% } %>
        <% if (locals.corrected) { %><output class="alert alert-success" aria-live="polite">Declined refund request reopened. It is now in Pending action.</output><% } %>
        <% if (locals.refundsEnabled === false) { %>
            <output class="alert alert-warning" aria-live="polite">Bank and external refunds are disabled system-wide. Pending requests remain visible but cannot be marked as done until refunds are enabled in Settings.</output>
        <% } %>
        <% if (decision === 'approved') { %>
            <output class="alert alert-success" aria-live="polite">Refund marked as done and the remaining credit deducted. <a href="/admin/credit-refunds/history?from_queue=1">Search refund history</a> using today's date to check the exact completed amount.</output>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-warning" role="alert">This request can no longer be actioned. It may already be decided or its credit fully spent.</div>
        <% } %>
        <% const money = pence => '£' + (pence / 100).toFixed(2); %>
        <% for (const pending of [!locals.historyPage]) { %>
            <% const items = pending ? requests.filter(request => request.status === 'pending') : history.entries; %>
            <section class="bg-white border rounded shadow-sm p-4 <%= pending ? 'mb-5' : 'mb-4' %>" aria-labelledby="<%= pending ? 'pending-refunds' : 'closed-refunds' %>">
                <header class="border-bottom pb-3 mb-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between">
                        <h2 class="h5 mb-0" id="<%= pending ? 'pending-refunds' : 'closed-refunds' %>"><%= pending ? 'Pending action' : 'History' %></h2>
                        <% if (pending) { %>
                            <span class="badge <%= items.length ? 'badge-warning' : 'badge-light text-muted' %>"><%= items.length %> awaiting action</span>
                        <% } else if (searched) { %>
                            <span class="badge badge-info"><%= history.total %> matching this period</span>
                        <% } %>
                    </div>
                    <p class="small text-muted mt-2 mb-0"><%= pending ? 'Action the refund requests below, then mark them as done.' : 'Completed requests are kept separate from the action queue. Choose a date range to search them.' %></p>
                </header>
                <% if (!pending) { %>
                    <p class="small text-muted">Search by completion date (Europe/London), including both dates. Maximum 62 days; 50 results per page.</p>
                    <form class="form-row align-items-end mb-3" method="GET" action="/admin/credit-refunds/history#closed-refunds">
                        <% if (locals.fromQueue) { %><input type="hidden" name="from_queue" value="1"><% } %>
                        <% const chosen = locals.selectedProfile; %>
                        <div class="form-group col-12" data-refund-profile-picker
                            data-guid="<%= chosen ? chosen.guid : '' %>" data-name="<%= chosen ? chosen.name : 'All profiles' %>"
                            data-email="<%= chosen ? chosen.email : '' %>">
                            <input type="hidden" name="profile" value="<%= chosen ? chosen.guid : '' %>">
                            <label for="refund-profile-search">Username</label>
                            <input class="form-control" id="refund-profile-search" type="search" value="<%= chosen ? chosen.name : '' %>" placeholder="Search by first name, surname or email" autocomplete="off" aria-describedby="refund-profile-help">
                            <small class="form-text text-muted" id="refund-profile-help">Enter at least 2 characters. Names work in either order. The best match is selected automatically; check the selection before searching history.</small>
                            <div class="profile-choice-list" data-refund-profile-choices role="radiogroup" aria-label="Refund history profile">
                                <label><input type="radio" name="refund-profile-choice" value="<%= chosen ? chosen.guid : '' %>" checked> <%= chosen ? chosen.name : 'All profiles' %></label>
                            </div>
                            <output class="sr-only" data-refund-profile-status aria-live="polite"></output>
                        </div>
                        <div class="form-group col-md">
                            <label for="refund-from">From date</label>
                            <input class="form-control" id="refund-from" name="from" type="date" value="<%= filters.from %>" required>
                        </div>
                        <div class="form-group col-md">
                            <label for="refund-to">To date</label>
                            <input class="form-control" id="refund-to" name="to" type="date" value="<%= filters.to %>" required>
                        </div>
                        <div class="form-group col-md-auto">
                            <a class="btn btn-outline-secondary mr-2" href="/admin/credit-refunds/history<%= locals.fromQueue ? '?from_queue=1' : '' %>">Clear</a>
                            <button class="btn btn-primary" type="submit">Search history</button>
                        </div>
                    </form>
                    <% if (searched) { %><output aria-live="polite"><%= history.total %> matching this period</output><% } %>
                <% } %>
                <% if (items.length) { %>
                    <div class="table-responsive bg-white border rounded">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Booking</th><th>Requested by</th><th>Requested amount</th><th>Remaining credit</th><th>Outcome</th><% if (!pending) { %><th>Completed (UK)</th><% } %></tr></thead>
                            <tbody>
                                <% items.forEach(request => { %>
                                    <tr>
                                        <td><code><%= request.booking_ref || 'Opening balance' %></code><br><span class="small">Payment ID: <code><%= request.payment_reference || 'Not recorded' %></code></span><br><%= request.facility_name %></td>
                                        <td><%= request.profile_name %><br><span class="small"><%= request.profile_email %></span></td>
                                        <td><%= money(request.requested_pence) %></td>
                                        <td><%= money(request.remaining_pence) %><% if (request.expired) { %><br><span class="badge badge-warning">Expired for spending; refund can still be completed</span><% } %></td>
                                        <td>
                                            <% if (pending) { %>
                                                <form method="POST" action="/admin/credit-refunds/decide">
                                                    <input type="hidden" name="request_guid" value="<%= request.guid %>">
                                                    <button class="btn btn-outline-primary btn-sm mb-1" type="submit" name="decision" value="approve" <%= locals.refundsEnabled === false ? 'disabled' : '' %> data-confirm="Mark this refund as done and deduct the current remaining credit? The amount may have decreased since this page loaded. This records completion; it does not send a bank transfer.">Mark as done</button>
                                                </form>
                                            <% } else { %>
                                                <strong><%= request.status === 'approved' ? 'Done ' + money(request.refunded_pence) : request.status === 'cancelled' ? 'Cancelled: profile deleted' : request.status === 'spent' ? 'Closed: credit fully spent' : 'Declined' %></strong>
                                                <% if (request.decided_by_name) { %><br><span class="small">By <%= request.decided_by_name %></span><% } %>
                                                <% if (request.status === 'declined') { %>
                                                    <p class="small mb-0">Reason: <%= request.decline_comment || 'No reason recorded for this older decision.' %></p>
                                                    <form method="POST" action="/admin/credit-refunds/reopen" class="mt-2">
                                                        <%- include('partials/request-history-fields', { request }) %>
                                                        <button class="btn btn-outline-primary btn-sm" type="submit" data-confirm="Reverse this decline and return the refund request to Pending action? No credit is deducted until it is marked as done.">Reopen request</button>
                                                    </form>
                                                <% } %>
                                            <% } %>
                                        </td>
                                        <% if (!pending) { %><td><%= new Date(request.decided_at).toLocaleString('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td><% } %>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %><p class="text-muted"><%= pending ? 'No refunds are waiting for action.' : searched ? 'No completed refund requests found for this period.' : 'Select From and To dates to load refund history.' %></p><% } %>
                <% if (!pending && searched && history.total > history.pageSize) {
                    const totalPages = Math.ceil(history.total / history.pageSize);
                    const pageLink = target => '/admin/credit-refunds/history?' + new URLSearchParams({ ...filters, ...(locals.fromQueue ? { from_queue: '1' } : {}), page: target }).toString() + '#closed-refunds';
                %>
                    <nav aria-label="Refund history pages" class="d-flex align-items-center mt-3">
                        <% if (page > 1) { %><a class="btn btn-outline-secondary btn-sm mr-2" href="<%= pageLink(page - 1) %>">Previous</a><% } %>
                        <span class="small mr-2">Page <%= page %> of <%= totalPages %></span>
                        <% if (page < totalPages) { %><a class="btn btn-outline-secondary btn-sm" href="<%= pageLink(page + 1) %>">Next</a><% } %>
                    </nav>
                <% } %>
            </section>
        <% } %>
    </main>
    <script>
        <%- include('partials/profile-search-behaviour') %>
        const picker = document.querySelector('[data-refund-profile-picker]');
        if (picker) {
            const finder = attachProfileSearch(
                picker.querySelector('#refund-profile-search'),
                picker.querySelector('[data-refund-profile-choices]'),
                picker.querySelector('[data-refund-profile-status]'),
                { guid: picker.dataset.guid, name: picker.dataset.name, email: picker.dataset.email },
                'refund-profile-choice', profile => { picker.querySelector('[name="profile"]').value = profile.guid; }
            );
            picker.querySelector('#refund-profile-search').addEventListener('input', event => {
                if (!event.target.value.trim()) finder.reset({ guid: '', name: 'All profiles' });
            });
        }
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                var button = event.submitter;
                if (button && button.dataset.confirm && !window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
</body>
</html>
