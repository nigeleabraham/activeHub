<script>
    (() => {
        const key = 'activehub-course-basket-return';
        document.addEventListener('submit', event => {
            if (event.target.getAttribute('action') !== '/basket/add') return;
            try {
                sessionStorage.setItem(key, JSON.stringify({
                    path: location.pathname,
                    scroll: window.scrollY,
                    open: Array.from(document.querySelectorAll('details')).map(detail => detail.open)
                }));
            } catch (error) {
                console.warn('Unable to remember the course page position:', error);
            }
        });
        try {
            const saved = JSON.parse(sessionStorage.getItem(key) || 'null');
            if (!saved || saved.path !== location.pathname) return;
            sessionStorage.removeItem(key);
            document.querySelectorAll('details').forEach((detail, index) => { detail.open = saved.open[index] === true; });
            requestAnimationFrame(() => window.scrollTo(0, saved.scroll));
        } catch (error) {
            console.warn('Unable to restore the course page position:', error);
        }
    })();
</script>
