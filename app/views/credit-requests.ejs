<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Credit requests | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <%- include('partials/booking-flow-styles') %>
</head>

<body class="bg-light">
    <%- include('partials/navigation') %>
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1">Credit requests</h1>
                <p class="text-muted mb-0">Weather and discretionary credit requests for past bookings</p>
            </div>
        </header>

        <% if (declineError) { %><div class="alert alert-danger" role="alert">Enter a decline comment of 1 to 500 characters. This will be visible to the requestor.</div><% } %>
        <% if (locals.corrected) { %><output class="alert alert-success" aria-live="polite">Request updated. Reopened requests are in Pending review.</output><% } %>
        <% if (decision) { %>
            <output class="alert alert-success" aria-live="polite">Request for booking <strong><%= decisionRef %></strong> was <%= decision %>.<%= decision === 'approved' ? ' The amount paid has been added to the profile\'s credit.' : '' %></output>
        <% } else if (error) { %>
            <div class="alert alert-warning" role="alert">That request could not be processed. It may already have been decided, or the booking may already be credited.</div>
        <% } %>

        <% const money = pence => '£' + (pence / 100).toFixed(2); %>
        <% const pending = requests.filter(request => request.status === 'pending'); %>
        <% const decided = history.entries; %>

        <section class="bg-white border rounded shadow-sm p-4 mb-4" aria-labelledby="auto-slots-heading">
            <h2 id="auto-slots-heading" class="h5">Auto-approved weather time slots (last <%= creditRequestDays %> days)</h2>
            <p><%= autoApprovalEnabled ? 'Enabled' : 'Disabled - saved slots are paused' %>. Matches exact start and end times across all facilities. <a href="/admin/settings#auto-approval-heading">Change in Settings</a>.</p>
            <% if (autoApprovalSlots.length) { %>
                <div class="table-responsive bg-white border rounded">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Start</th><th>End</th><th>Approved by</th></tr></thead>
                        <tbody><% autoApprovalSlots.forEach(slot => { %>
                            <tr>
                                <td><time data-local-time datetime="<%= new Date(slot.starts_at).toISOString() %>"><%= new Date(slot.starts_at).toISOString() %></time></td>
                                <td><time data-local-time datetime="<%= new Date(slot.ends_at).toISOString() %>"><%= new Date(slot.ends_at).toISOString() %></time></td>
                                <td><%= slot.approved_by_name %></td>
                            </tr>
                        <% }) %></tbody>
                    </table>
                </div>
            <% } else { %><p class="text-muted">No auto-approved slots in this period.</p><% } %>
        </section>

        <section class="bg-white border rounded shadow-sm p-4 mb-5" aria-labelledby="pending-heading">
            <header class="border-bottom pb-3 mb-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between">
                    <h2 id="pending-heading" class="h5 mb-0">Pending review</h2>
                    <span class="badge <%= pending.length ? 'badge-warning' : 'badge-light text-muted' %>"><%= pending.length %> awaiting review</span>
                </div>
                <p class="small text-muted mt-2 mb-0">Action needed: approve or decline the credit requests below.</p>
            </header>
            <% if (pending.length) { %>
                <div class="table-responsive bg-white border rounded shadow-sm">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Reference</th><th>Requested by</th><th>Booking</th><th>Paid</th><th>Note</th><th></th></tr></thead>
                        <tbody>
                            <% pending.forEach(request => { %>
                                <tr>
                                    <td><code><%= request.booking_ref %></code><br><span class="small">Payment ID: <code><%= request.payment_reference || 'Not recorded' %></code></span></td>
                                    <td><%= request.profile_name || 'Unknown' %><br><span class="small text-muted"><%= request.profile_email %></span><br>
                                        <span class="small text-muted"><time data-local-time datetime="<%= new Date(request.requested_at).toISOString() %>"><%= new Date(request.requested_at).toISOString() %></time></span></td>
                                    <td><%= request.facility_name %><br><span class="small text-muted"><%= request.option_name %> · <%= request.sport_name %></span><br>
                                        <time data-local-time datetime="<%= new Date(request.starts_at).toISOString() %>"><%= new Date(request.starts_at).toISOString() %></time></td>
                                    <td><%= money(request.amount_paid_pence) %>
                                        <%- include('partials/booking-funding', { booking: request }) %>
                                    </td>
                                    <td class="small"><strong><%= request.reason === 'weather' ? 'Weather' : 'Discretionary (Other)' %></strong><br><%= request.note || '—' %></td>
                                    <td>
                                        <form method="POST" action="/admin/credit-requests/decide">
                                            <input type="hidden" name="request_guid" value="<%= request.guid %>">
                                            <% if (request.reason === 'weather') { %>
                                                <p class="small mb-1">Weather credit for the card-paid portion is refundable. Reissued credits retain their original refund eligibility.</p>
                                            <% } else { %>
                                                <input type="hidden" name="decision" value="approve">
                                                <p class="small mb-1">Non-refundable approval makes the entire award non-refundable, including any refundable credit used. Refundable approval preserves original credit eligibility and makes the card-paid portion refundable.</p>
                                            <% } %>
                                            <% if (autoApprovalEnabled && request.reason === 'weather') { %>
                                                <label class="d-block small"><input type="checkbox" name="approve_slot" value="1"> Also auto-approve existing and future weather requests at all facilities with this exact start and end time. Only the card-paid portion gains refund eligibility; reissued credits keep their original eligibility.</label>
                                            <% } %>
                                            <% if (request.reason === 'weather') { %>
                                                <button class="btn btn-outline-primary btn-sm mb-1" type="submit" name="decision" value="approve" data-confirm="Add <%= money(request.amount_paid_pence) %> to <%= request.profile_name %>'s credit for booking <%= request.booking_ref %>?">Approve and add credit</button>
                                            <% } else { %>
                                                <button class="btn btn-outline-primary btn-sm mb-1" type="submit" name="refundable" value="1" data-confirm="Add <%= money(request.amount_paid_pence) %> to <%= request.profile_name %>'s credit for booking <%= request.booking_ref %>, with the card-paid portion refundable? Reissued credits retain their original refund eligibility.">Approve (refundable)</button>
                                                <button class="btn btn-outline-primary btn-sm mb-1" type="submit" name="refundable" value="0" data-confirm="Add <%= money(request.amount_paid_pence) %> to <%= request.profile_name %>'s credit for booking <%= request.booking_ref %> as entirely non-refundable credit? This overrides the eligibility of any refundable credit originally used.">Approve (non-refundable)</button>
                                            <% } %>
                                        </form>
                                        <form method="POST" action="/admin/credit-requests/decide">
                                            <input type="hidden" name="request_guid" value="<%= request.guid %>">
                                            <label class="small d-block" for="decline-<%= request.guid %>">Decline reason (visible to requestor)</label>
                                            <textarea class="form-control form-control-sm mb-1" id="decline-<%= request.guid %>" name="decline_comment" maxlength="500" rows="2" required></textarea>
                                            <button class="btn btn-outline-secondary btn-sm mb-1" type="submit" name="decision" value="decline" data-confirm="Decline the request for booking <%= request.booking_ref %>?">Decline</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <p class="text-muted">No requests are waiting.</p>
            <% } %>
        </section>

            <section class="bg-white border rounded shadow-sm p-4 mb-4" aria-labelledby="decided-heading">
                <header class="border-bottom pb-3 mb-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between">
                        <h2 id="decided-heading" class="h5 mb-0">History</h2>
                        <% if (searched) { %><span class="badge badge-info"><%= history.total %> matching this period</span><% } %>
                    </div>
                    <p class="small text-muted mt-2 mb-0">Completed requests are kept separate from the review queue. Choose a date range to search them.</p>
                </header>
                <%- include('partials/credit-history-search') %>
                <% if (decided.length) { %>
                <div class="table-responsive bg-white border rounded shadow-sm">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Reference</th><th>Requested by</th><th>Booking</th><th>Outcome</th><th>Completed (UK)</th></tr></thead>
                        <tbody>
                            <% decided.forEach(request => { %>
                                <tr>
                                    <td><code><%= request.booking_ref %></code><br><span class="small">Payment ID: <code><%= request.payment_reference || 'Not recorded' %></code></span></td>
                                    <td><%= request.profile_name || 'Unknown' %></td>
                                    <td><%= request.facility_name %> · <time data-local-time datetime="<%= new Date(request.starts_at).toISOString() %>"><%= new Date(request.starts_at).toISOString() %></time><br><strong><%= request.reason === 'weather' ? 'Weather' : 'Discretionary (Other)' %></strong><br><span class="small"><%= request.note || '—' %></span></td>
                                    <td><span class="badge badge-<%= request.status === 'approved' ? 'success' : 'secondary' %>"><%= request.status === 'approved' ? 'Credited ' + money(request.amount_paid_pence) : request.status === 'cancelled' ? 'Cancelled: profile deleted' : 'Declined' %></span>
                                        <span class="small text-muted"><%= request.decided_by_name ? 'by ' + request.decided_by_name : '' %></span>
                                        <% if (request.auto_approved) { %><span class="badge badge-info">Auto-approved weather slot</span><% } %>
                                        <% if (request.status === 'declined') { %>
                                            <p class="small mb-0">Reason: <%= request.decline_comment || 'No reason recorded for this older decision.' %></p>
                                            <form method="POST" action="/admin/credit-requests/reopen" class="mt-2">
                                                <%- include('partials/request-history-fields', { request }) %>
                                                <button class="btn btn-outline-primary btn-sm" type="submit" data-confirm="Reverse this decline and return the request to Pending review? No credit is issued until it is approved.">Reopen request</button>
                                            </form>
                                        <% } %>
                                        <% if (request.status === 'approved') { %>
                                            <p class="small mt-2 mb-1">Available credit: <%= money(request.available_refundable_pence || 0) %> refundable / <%= money(request.available_non_refundable_pence || 0) %> non-refundable.</p>
                                            <form method="POST" action="/admin/credit-requests/refundability" class="mt-2">
                                                <%- include('partials/request-history-fields', { request }) %>
                                                <label class="small d-block" for="refundability-<%= request.guid %>">Remaining card-paid credit</label>
                                                <select class="form-control form-control-sm mb-1" id="refundability-<%= request.guid %>" name="refundable">
                                                    <option value="1">Make refundable</option>
                                                    <option value="0">Make non-refundable</option>
                                                </select>
                                                <p class="small text-muted mb-1">Reused credit keeps its eligibility. Pending bank refund requests block changes. Only unspent, unexpired card-paid credit can change.</p>
                                                <button class="btn btn-outline-primary btn-sm" type="submit" data-confirm="Change refund eligibility for the remaining card-paid credit only? The total credit balance will not change.">Update refund eligibility</button>
                                            </form>
                                        <% } %></td>
                                    <td><%= new Date(request.decided_at).toLocaleString('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } else { %><p class="text-muted"><%= searched ? 'No completed credit requests found for this period.' : 'Select From and To dates to load credit history.' %></p><% } %>
                <% if (searched && history.total > history.pageSize) {
                    const totalPages = Math.ceil(history.total / history.pageSize);
                    const pageLink = target => '/admin/credit-requests?' + new URLSearchParams({ ...filters, page: target }).toString() + '#decided-heading';
                %>
                    <nav aria-label="Credit history pages" class="d-flex align-items-center mt-3">
                        <% if (page > 1) { %><a class="btn btn-outline-secondary btn-sm mr-2" href="<%= pageLink(page - 1) %>">Previous</a><% } %>
                        <span class="small mr-2">Page <%= page %> of <%= totalPages %></span>
                        <% if (page < totalPages) { %><a class="btn btn-outline-secondary btn-sm" href="<%= pageLink(page + 1) %>">Next</a><% } %>
                    </nav>
                <% } %>
            </section>
    </main>

    <script>
        <%- include('partials/profile-search-behaviour') %>
        const picker = document.querySelector('[data-credit-profile-picker]');
        if (picker) {
            const finder = attachProfileSearch(
                picker.querySelector('#credit-profile-search'),
                picker.querySelector('[data-credit-profile-choices]'),
                picker.querySelector('[data-credit-profile-status]'),
                { guid: picker.dataset.guid, name: picker.dataset.name, email: picker.dataset.email },
                'credit-profile-choice', profile => { picker.querySelector('[name="profile"]').value = profile.guid; }
            );
            picker.querySelector('#credit-profile-search').addEventListener('input', event => {
                if (!event.target.value.trim()) finder.reset({ guid: '', name: 'All profiles' });
            });
        }
        var timeFormat = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
        document.querySelectorAll('[data-local-time]').forEach(function (time) {
            var instant = new Date(time.dateTime);
            if (Number.isFinite(instant.getTime())) time.textContent = timeFormat.format(instant);
        });
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                var button = event.submitter;
                if (button && button.dataset.confirm && !window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
</body>

</html>
