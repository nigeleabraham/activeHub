<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sports | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <style>
        [data-editor-inline] { position: relative; }
        [data-editor-inline] input[name="name"] { height: 2.5rem; }
        [data-editor-inline] .admin-editor-status { position: absolute; top: 100%; margin: 0.5rem 0 0; }
    </style>
</head>

<body class="bg-light">
    <%- include('partials/navigation') %>
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1">Sports</h1>
                <p class="text-muted mb-0">Manage the sports available for facilities</p>
            </div>
        </header>

        <div class="admin-save-feedback mb-4">
            <p class="alert text-muted mb-0" data-admin-save-placeholder>You can add, remove, and edit sports here. These can then be assigned to the sports facilities.</p>
        </div>

        <section class="mb-3" aria-labelledby="add-sport-heading">
            <div class="bg-white border rounded shadow-sm p-3">
                <h2 id="add-sport-heading" class="h5 mb-2">Add sport</h2>
                <form class="form-row align-items-end" method="POST" action="/admin/sports">
                    <div class="form-group col-md mb-md-0">
                        <label for="sport-name">Sport name</label>
                        <input class="form-control" id="sport-name" name="name" type="text" maxlength="120" required>
                    </div>
                    <div class="col-md-auto">
                        <button class="btn btn-primary" type="submit">Add sport</button>
                    </div>
                </form>
            </div>
        </section>

        <section aria-labelledby="sports-list-heading" data-sports-directory>
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 id="sports-list-heading" class="h5 mb-0">Directory</h2>
                <span class="badge badge-secondary" data-sport-count><%= sports.length %></span>
            </div>
            <div class="sr-only" data-sport-feedback role="status" aria-live="polite" aria-atomic="true"></div>
            <div class="alert alert-danger" data-sport-error role="alert" tabindex="-1" hidden></div>
            <div data-sport-list>
            <% if (sports.length) { %>
                <article class="bg-white border rounded shadow-sm p-4 mb-3">
                    <ul class="list-group list-group-flush">
                        <% sports.forEach(sport => { %>
                            <li id="sport-<%= sport.guid %>" class="list-group-item px-0" data-sport-guid="<%= sport.guid %>" data-sport-name="<%= sport.name %>">
                                <details data-sport-details>
                                    <summary class="h5 mb-0" style="min-height: 2.5rem;">
                                        <span><%= sport.name %></span>
                                        <span data-sport-edit-feedback class="d-inline-block align-middle ml-3" style="height: 2.5rem; max-width: 65%; overflow: auto; vertical-align: middle;"></span>
                                    </summary>
                                <div class="pt-3">
                                <div class="d-flex justify-content-between align-items-end">
                                    <div class="flex-grow-1 mr-2" style="min-width: 0;">
                                        <form class="form-row align-items-end" method="POST" action="/admin/sports/update" data-editor-inline data-editor-label="Update <%= sport.name %> sport title">
                                            <input type="hidden" name="guid" value="<%= sport.guid %>">
                                            <div class="form-group col mb-0">
                                                <label class="sr-only" for="edit-sport-name-<%= sport.guid %>">Sport title</label>
                                                <input class="form-control" id="edit-sport-name-<%= sport.guid %>" name="name" type="text" maxlength="120" value="<%= sport.name %>" required>
                                            </div>
                                            <div class="col-auto"><button class="btn btn-primary" type="submit">Update</button></div>
                                        </form>
                                    </div>
                                    <div class="d-flex align-items-center flex-shrink-0">
                                        <form method="POST" action="/admin/sports/destroy">
                                            <input type="hidden" name="guid" value="<%= sport.guid %>">
                                            <button class="btn btn-outline-danger" type="submit" aria-label="Delete <%= sport.name %>">Delete</button>
                                        </form>
                                    </div>
                                </div>
                                <section class="border rounded bg-light p-3 mt-3" aria-labelledby="course-defaults-heading-<%= sport.guid %>">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between">
                                        <h3 class="h6 mb-2" id="course-defaults-heading-<%= sport.guid %>"><%= sport.name %> course defaults <span class="text-muted font-weight-normal">(<%= (sport.course_description_sections || []).length %> default sections)</span></h3>
                                        <button class="btn btn-outline-primary btn-sm mb-2" type="button" data-edit-toggle aria-expanded="false" aria-controls="course-defaults-<%= sport.guid %>">Edit course defaults</button>
                                    </div>
                                    <p class="small mb-1">Default description sections for courses targeting this sport. Courses can inherit each section, override it, or append their own sections.</p>
                                    <p class="small text-muted mb-0">Changes apply to inherited sections only; unique course overrides are preserved.</p>
                                    <div id="course-defaults-<%= sport.guid %>" data-edit-panel hidden>
                                        <form class="mt-3" method="POST" action="/admin/sports/course-defaults" data-editor-label="<%= sport.name %> course defaults">
                                            <input type="hidden" name="guid" value="<%= sport.guid %>">
                                            <%- include('partials/description-sections-editor', { field: 'course_description_sections', sections: sport.course_description_sections || [] }) %>
                                        </form>
                                    </div>
                                </section>
                                </div>
                                </details>
                            </li>
                        <% }); %>
                    </ul>
                </article>
            <% } else { %>
                <p class="text-muted border-top pt-3">No sports have been added.</p>
            <% } %>
            </div>
        </section>
    </main>
</body>

</html>
