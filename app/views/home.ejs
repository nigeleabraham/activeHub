<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome | <%= siteTitle %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
    <style>
        body { font-family: "Inter", Arial, sans-serif; color: #0b0c0c; background: #f2f5f9; }
        a { color: #003e90; }
        .site-bar { background: #fff; border-bottom: 0.6rem solid #ffde02; }
        .brand-mark { font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif; font-weight: 600; font-size: 1.75rem; line-height: 1; color: #0b0c0c; letter-spacing: -0.045em; }
        .brand-logo { height: 2rem; width: auto; max-width: 12rem; }
        .brand-hero { background: #113255; color: #fff; padding: 4rem 0; }
        .brand-hero h1 { font-size: 2.25rem; font-weight: 700; line-height: 1.15; max-width: 20ch; }
        .brand-hero .lead { overflow-wrap: anywhere; }
        .brand-tile { display: block; height: 100%; padding: 1.5rem; background: #fff; color: #0b0c0c; border: 1px solid #b1b4b6; border-bottom: 0.4rem solid #113255; border-radius: 0; }
        .brand-tile h3 { font-weight: 700; color: #003e90; text-decoration: underline; text-underline-offset: 0.2em; }
        a.brand-tile:hover { color: #0b0c0c; background: #fff9cc; border-bottom-color: #ffde02; }
        a.brand-tile:focus { outline: 3px solid transparent; background: #ffde02; box-shadow: 0 -2px #ffde02, 0 4px #0b0c0c; }
        .brand-tile .icon { font-size: 1.75rem; }
        .brand-tiles { margin-top: 2.5rem; }
        .text-muted { color: #505a5f !important; }
        @media (min-width: 768px) { .brand-hero h1 { font-size: 3rem; } }
    </style>
    <%- include('partials/resident-banner-styles') %>
</head>

<body class="bg-light">
    <%- include('partials/cookie-banner') %>
    <div class="site-bar">
        <div class="container py-3 d-md-flex justify-content-between align-items-center">
            <% if (hasLogo) { %><img class="brand-logo" src="/site-logo" alt="<%= siteTitle %> logo"><% } else { %><span></span><% } %>
            <%- include('partials/navigation') %>
        </div>
    </div>

    <header class="brand-hero">
        <div class="container">
            <%- include('partials/basket-button') %>
            <h1 class="mb-3"><%= siteTitle %></h1>
            <p class="lead mb-0">Welcome back, <%= currentProfile.name %>. Find and book sport, fitness and wellbeing services near you.</p>
        </div>
    </header>

    <%- include('partials/customer-navigation') %>
    <main class="container brand-tiles pb-5">
        <section class="mb-4" aria-labelledby="get-active-heading">
            <h2 class="h3 mb-4" id="get-active-heading">Get Active</h2>
            <div class="row">
            <div class="col-md-6 col-lg-4 mb-4">
                <a class="brand-tile text-decoration-none" href="/facilities"><div>
                    <div class="icon" aria-hidden="true">🏟️</div>
                    <h3 class="h5 mt-2">Facilities</h3>
                    <p class="text-muted mb-0">Discover the venues near you and when they are open.</p>
                </div></a>
            </div>
            <div class="col-md-6 col-lg-4 mb-4">
                <a class="brand-tile text-decoration-none" href="/court-bookings"><div>
                    <div class="icon" aria-hidden="true">📅</div>
                    <h3 class="h5 mt-2">Book a court or space</h3>
                    <p class="text-muted mb-0">Choose an available court or space and book a time.</p>
                </div></a>
            </div>
            <div class="col-md-6 col-lg-4 mb-4">
                <a class="brand-tile text-decoration-none" href="/courses"><div>
                    <div class="icon" aria-hidden="true">🥇</div>
                    <h3 class="h5 mt-2">Book a course</h3>
                    <p class="text-muted mb-0">Find a class or coaching programme and book a place.</p>
                </div></a>
            </div>
            </div>
        </section>

        <section class="mb-4" aria-labelledby="my-account-heading">
            <h2 class="h3 mb-4" id="my-account-heading">My Account</h2>
            <div class="row">
            <div class="col-md-6 col-lg-4 mb-4">
                <a class="brand-tile text-decoration-none" href="/profile"><div>
                    <div class="icon" aria-hidden="true">👤</div>
                    <h3 class="h5 mt-2">My profile</h3>
                    <p class="text-muted mb-0">Update your name and email address.</p>
                </div></a>
            </div>
            <div class="col-md-6 col-lg-4 mb-4">
                <a class="brand-tile text-decoration-none" href="/credits-and-refunds"><div>
                    <div class="icon" aria-hidden="true">💷</div>
                    <h3 class="h5 mt-2">Credits and refunds</h3>
                    <p class="text-muted mb-0">View booking credit, request bank refunds and review recent past bookings.</p>
                </div></a>
            </div>
            <div class="col-md-6 col-lg-4 mb-4">
                <a class="brand-tile text-decoration-none" href="/bookings"><div>
                    <div class="icon" aria-hidden="true">🧾</div>
                    <h3 class="h5 mt-2">My bookings</h3>
                    <p class="text-muted mb-0">See your upcoming court and course bookings.</p>
                </div></a>
            </div>
            </div>
        </section>

        <% if (locals.canAccessAdmin ? locals.canAccessAdmin('/') : isAdmin || (currentProfile?.permissions || []).length > 0) { %>
            <section aria-labelledby="administration-heading">
                <h2 class="h3 mb-4" id="administration-heading">Administration</h2>
                <div class="row">
                <div class="col-md-6 col-lg-4 mb-4">
                    <a class="brand-tile text-decoration-none" href="/admin">
                        <div>
                            <div class="icon" aria-hidden="true">⚙️</div>
                            <h3 class="h5 mt-2">Administration</h3>
                            <p class="text-muted mb-0">Open the management areas available to your active role.</p>
                        </div>
                    </a>
                </div>
                </div>
            </section>
        <% } %>
    </main>
</body>

</html>
