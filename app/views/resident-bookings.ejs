<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My bookings | <%= siteTitle %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
    <style>
        body { font-family: "Inter", Arial, sans-serif; color: #0b0c0c; background: #f2f5f9; }
        a { color: #003e90; }
        .site-bar { background: #fff; border-bottom: 0.6rem solid #ffde02; }
        .brand-logo { height: 2rem; width: auto; max-width: 12rem; }
        .page-head { background: #113255; color: #fff; padding: 2.5rem 0; }
        .page-head h1 { font-size: 2.25rem; font-weight: 700; }
        .page-head a { color: #fff; }
        .panel { background: #fff; border: 1px solid #b1b4b6; border-bottom: 0.4rem solid #113255; padding: 1.5rem; margin-bottom: 2rem; }
        .booking-item { border-left: 0.4rem solid #113255; background: #f8f9fa; padding: 0.75rem 1rem; margin-bottom: 0.75rem; }
        .form-control:focus, .btn:focus, a:focus { outline: 3px solid transparent; box-shadow: 0 0 0 3px #ffde02, 0 0 0 6px #0b0c0c; }
        .text-muted { color: #505a5f !important; }
    </style>
    <%- include('partials/resident-banner-styles') %>
</head>

<body>
    <%- include('partials/cookie-banner') %>
    <div class="site-bar">
        <div class="container py-3 d-md-flex justify-content-between align-items-center">
            <a href="/"><% if (hasLogo) { %><img class="brand-logo" src="/site-logo" alt="<%= siteTitle %> logo"><% } else { %><%= siteTitle %><% } %></a>
            <%- include('partials/navigation') %>
        </div>
    </div>

    <header class="page-head">
        <div class="container">
            <%- include('partials/basket-button') %>
            <p class="mb-2"><a href="/">&larr; Back to home</a></p>
            <h1 class="mb-2">My bookings</h1>
            <p class="lead mb-0">See your upcoming court and course bookings.</p>
        </div>
    </header>

    <%- include('partials/customer-navigation') %>
    <main class="container pb-5">
        <p class="mt-4"><a href="/court-bookings">Book a court or space</a> <span class="mx-2">|</span> <a href="/courses">Browse course bookings</a></p>
        <%- include('partials/booking-messages') %>

        <details class="panel" data-court-bookings>
            <summary id="my-bookings" class="h4 mb-3">Court bookings (<%= myBookings.length %>)</summary>
            <% if (myBookings.length) { %>
                <ul class="list-unstyled mb-0">
                    <% myBookings.forEach(booking => { %>
                        <li class="booking-item">
                            <strong><%= booking.facility_name %></strong> · <%= booking.option_name %> · <%= booking.sport_name %> <span class="text-muted small">Ref <code><%= booking.booking_ref %></code></span><br>
                            <time data-local-booking-time datetime="<%= new Date(booking.starts_at).toISOString() %>"><%= new Date(booking.starts_at).toISOString() %></time>
                            to <time data-local-booking-end datetime="<%= new Date(booking.ends_at).toISOString() %>"><%= new Date(booking.ends_at).toISOString() %></time>
                            <span class="d-block small"><%= booking.payment_status === 'paid' ? 'Paid £' + ((booking.amount_pence - booking.credit_applied_pence) / 100).toFixed(2) + (booking.credit_applied_pence ? ' + £' + (booking.credit_applied_pence / 100).toFixed(2) + ' credit' : '') + ' · ref ' + booking.payment_reference : booking.payment_status === 'credit' ? 'Paid with credit £' + (booking.credit_applied_pence / 100).toFixed(2) + ' · ref ' + booking.payment_reference : 'No payment required' %></span>
                            <span class="d-block text-muted small"><%= booking.address %>, <%= booking.postcode %> ·
                                <a href="<%= booking.google_maps_url %>" target="_blank" rel="noopener noreferrer">Directions<span class="sr-only"> to <%= booking.facility_name %> (opens in a new tab)</span></a></span>
                        </li>
                    <% }) %>
                </ul>
                <p class="text-muted small mt-3 mb-0">To change or cancel a booking, please contact the facility.</p>
            <% } else { %>
                <p class="text-muted mb-0">You have no upcoming bookings.</p>
            <% } %>
        </details>

        <details class="panel" data-course-bookings>
            <summary class="h4 mb-3">Course bookings (<%= courseBookings.length %>)</summary>
            <% if (courseBookings.length) { %>
                <ul class="list-unstyled mb-0">
                    <% courseBookings.forEach(booking => { %>
                        <li class="booking-item">
                            <p class="h5 mb-2">Booked for: <strong><%= booking.attendee_name %></strong><%= booking.member_guid ? ' (child)' : ' (you)' %></p>
                            <p class="mb-1"><strong><%= booking.course_name %></strong></p>
                            <p class="mb-1"><%= booking.run_name %> &mdash; <%= booking.facility_name %></p>
                            <p class="mb-1">Reference: <code><%= booking.booking_ref %></code> &middot; Price: £<%= (booking.amount_pence / 100).toFixed(2) %></p>
                            <p class="mb-1"><%= booking.sessions.length %> upcoming <%= booking.sessions.length === 1 ? 'session' : 'sessions' %>:</p>
                            <ul class="mb-2">
                                <% booking.sessions.forEach(session => { %>
                                    <li><time data-local-booking-time datetime="<%= session.starts_at %>"><%= session.starts_at %></time>
                                        to <time data-local-booking-end datetime="<%= session.ends_at %>"><%= session.ends_at %></time></li>
                                <% }); %>
                            </ul>
                            <a href="/course-orders/<%= booking.order_guid %>">View confirmation<span class="sr-only"> for <%= booking.attendee_name %> &mdash; <%= booking.course_name %></span></a>
                        </li>
                    <% }); %>
                </ul>
                <p class="text-muted small mt-3 mb-0">To change or cancel a course booking, please contact the facility.</p>
            <% } else { %>
                <p class="text-muted mb-0">You and your children have no upcoming course bookings.</p>
            <% } %>
        </details>

    </main>

    <%- include('partials/booking-flow-script') %>
    <script>
        (function () {
            document.querySelectorAll('[data-local-booking-end]').forEach(function (time) {
                var instant = new Date(time.dateTime);
                if (Number.isFinite(instant.getTime())) time.textContent = formatCalendarDateTime(instant);
            });
        })();
    </script>
</body>

</html>
