<section class="panel booking-form" aria-labelledby="make-booking">
    <h2 id="make-booking" class="h4 mb-3">Book a court or space</h2>
    <% if (creditBalance > 0) { %>
        <p class="font-weight-bold">You have £<%= (creditBalance / 100).toFixed(2) %> of booking credit. It is used automatically at checkout.</p>
    <% } %>
    <% if (facilities.length) { %>
        <p class="text-muted">Bookings are for you only and you can book up to one month in advance. Upcoming booking limits apply only to the Resident role. Pick several slots to book them together.</p>
        <div class="form-group facility-picker">
            <label for="facility-picker" class="font-weight-bold">Facility</label>
            <select id="facility-picker" class="form-control form-control-lg">
                <% facilities.forEach(facility => { %>
                    <option value="<%= facility.guid %>" <%= facility.guid === selectedFacilityGuid ? 'selected' : '' %>><%= facility.name %></option>
                <% }) %>
            </select>
        </div>
        <% facilities.forEach(facility => { %>
            <div data-facility-panel="<%= facility.guid %>" <%= facility.guid !== selectedFacilityGuid ? 'hidden' : '' %>>
                <p class="text-muted small"><%= facility.address %>, <%= facility.postcode %></p>
                <% if (facility.limit !== null) { %>
                    <p class="font-weight-bold" data-limit-note>You have <%= facility.used %> of <%= facility.limit %> upcoming bookings at this facility<%= facility.used >= facility.limit ? '. You have reached the limit.' : '.' %></p>
                <% } else { %>
                    <p class="font-weight-bold" data-limit-note>You have <%= facility.used %> upcoming bookings at this facility. Your role has no upcoming booking limit.</p>
                <% } %>
                <div class="booking-calendar border rounded p-3" data-booking-calendar data-facility-guid="<%= facility.guid %>" data-availability-url="/bookings/availability/" data-max-date="<%= maxDate %>" <% if (facility.limit !== null) { %>data-max-selectable="<%= Math.max(0, facility.limit - facility.used) %>"<% } %>>
                    <div class="booking-calendar-header d-flex flex-wrap align-items-end justify-content-between mb-3">
                        <div class="form-group court-space-picker mb-2 mr-3">
                            <label for="calendar-option-<%= facility.guid %>">Court or space</label>
                            <select class="form-control form-control-lg" id="calendar-option-<%= facility.guid %>" data-calendar-option>
                                <% facility.options.forEach(option => { %>
                                    <option value="<%= option.guid %>"><%= option.name %> · <%= option.sport_name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="booking-calendar-day-nav mb-2">
                            <button class="btn btn-outline-secondary booking-calendar-day-nav__button" type="button" data-calendar-day-previous aria-label="Previous day">&lt;</button>
                            <strong class="booking-calendar-day-nav__date" data-calendar-date aria-live="polite" aria-atomic="true"></strong>
                            <button class="btn btn-outline-secondary booking-calendar-day-nav__button" type="button" data-calendar-day-next aria-label="Next day">&gt;</button>
                        </div>
                    </div>
                    <p class="small text-muted mb-2">Times use your local timezone. Each slot is one hour.</p>
                    <fieldset class="booking-calendar-slots semantic-control-group mb-3" data-calendar-slots aria-label="Booking times"></fieldset>
                    <p class="small mb-2" data-calendar-selection aria-live="polite">Select available time slots to add them to your list.</p>
                    <p class="text-danger small mb-2" data-calendar-error role="alert" aria-live="polite" hidden></p>
                    <h3 class="h6">Selected slots (<span data-pending-count>0</span>)</h3>
                    <ul class="list-group list-group-flush mb-3" data-pending-list></ul>
                    <form method="POST" action="/bookings/checkout" data-booking-form data-native-submit>
                        <input type="hidden" name="facility_guid" value="<%= facility.guid %>">
                        <input type="hidden" name="slots" data-selected-slots>
                        <button class="btn btn-primary btn-sm" type="submit" data-booking-submit disabled>Continue to payment</button>
                        <p class="text-danger small mt-2 mb-0" data-booking-error role="alert" aria-live="polite" hidden></p>
                    </form>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <p class="text-muted mb-0">No facilities are open for online booking yet.</p>
    <% } %>
</section>
<script>
    (() => {
        const picker = document.getElementById('facility-picker');
        if (!picker) return;
        picker.addEventListener('change', () => {
            document.querySelectorAll('[data-facility-panel]').forEach(panel => {
                panel.hidden = panel.dataset.facilityPanel !== picker.value;
            });
        });
    })();
</script>
