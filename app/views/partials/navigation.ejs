<% const navigationItems = [
    { key: 'facilities', label: 'Facilities', href: '/' },
    { key: 'courses', label: 'Courses', href: '/courses' },
    { key: 'sports', label: 'Sports', href: '/sports' },
    { key: 'opening-hours', label: 'Opening hours', href: '/opening-hours' },
    { key: 'bookings', label: 'Bookings', href: '/bookings' }
]; %>
<nav class="mt-3 mt-md-0" aria-label="Main navigation">
    <% navigationItems.forEach(item => { %>
        <a class="btn <%= activePage === item.key ? 'btn-primary' : 'btn-outline-secondary' %> btn-sm" href="<%= item.href %>"<% if (activePage === item.key) { %> aria-current="page"<% } %>><%= item.label %></a>
    <% }); %>
</nav>
