<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Credits and refunds | <%= siteTitle %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
    <style>
        body { font-family: "Inter", Arial, sans-serif; color: #0b0c0c; background: #f2f5f9; }
        a { color: #003e90; }
        .site-bar { background: #fff; border-bottom: 0.6rem solid #ffde02; }
        .brand-logo { height: 2rem; width: auto; max-width: 12rem; }
        .page-head { background: #113255; color: #fff; padding: 2.5rem 0; }
        .page-head h1 { font-size: 2.25rem; font-weight: 700; }
        .page-head a { color: #fff; }
        .panel { background: #fff; border: 1px solid #b1b4b6; border-bottom: 0.4rem solid #113255; padding: 1.5rem; margin-bottom: 2rem; }
        .panel:first-of-type { margin-top: -1.5rem; }
        .booking-item.is-past { border-left-color: #6f777b; background: #ececec; }
        .badge-when { font-size: 0.8rem; }
        .booking-item { border-left: 0.4rem solid #113255; background: #f8f9fa; padding: 0.75rem 1rem; margin-bottom: 0.75rem; }
        .form-control:focus, .btn:focus, a:focus { outline: 3px solid transparent; box-shadow: 0 0 0 3px #ffde02, 0 0 0 6px #0b0c0c; }
        .text-muted { color: #505a5f !important; }
    </style>
</head>

<body>
    <%- include('partials/cookie-banner') %>
    <div class="site-bar">
        <div class="container py-3 d-md-flex justify-content-between align-items-center">
            <a href="/"><% if (hasLogo) { %><img class="brand-logo" src="/site-logo" alt="<%= siteTitle %> logo"><% } else { %><%= siteTitle %><% } %></a>
            <%- include('partials/navigation') %>
        </div>
    </div>

    <header class="page-head">
        <div class="container">
            <p class="mb-2"><a href="/">&larr; Back to home</a></p>
            <h1 class="mb-2">Credits and refunds</h1>
            <p class="lead mb-0">Your booking credit, refund requests and recent past bookings.</p>
        </div>
    </header>

    <main class="container pb-5">
        <% const paymentText = booking => booking.payment_status === 'paid'
            ? 'Paid £' + ((booking.amount_pence - booking.credit_applied_pence) / 100).toFixed(2) + (booking.credit_applied_pence ? ' + £' + (booking.credit_applied_pence / 100).toFixed(2) + ' credit' : '')
            : booking.payment_status === 'credit' ? 'Paid with credit £' + (booking.credit_applied_pence / 100).toFixed(2) : 'No payment required'; %>
        <section class="panel" aria-labelledby="booking-credit">
            <h2 id="booking-credit" class="h4 mb-3">Booking credit</h2>
            <% if (autoApproved) { %>
                <div class="alert alert-success" role="status">
                    <strong>Automatically approved — your booking credit has been added.</strong>
                </div>
            <% } %>
            <p><strong>Total available: £<%= (creditBalance / 100).toFixed(2) %></strong></p>
            <p class="small text-muted">Unexpired credit is used automatically at checkout, when booking. The oldest credit is drawn down first. You can still spend unexpired credit while a bank refund is pending review. A refund requested before expiry remains pending for review, but expired credit cannot be spent.</p>
            <% if (refundRequested) { %><div class="alert alert-success" role="status">Your bank refund request is pending review.</div><% } %>
            <% if (refundError) { %><div class="alert alert-warning" role="alert">That credit cannot be requested for a bank refund. It may be non-refundable, expired, already requested or fully spent.</div><% } %>
            <% if (credits.length) { %>
                <ul class="list-unstyled mb-0">
                    <% credits.forEach(credit => { %>
                        <li class="booking-item">
                            <strong><%= credit.facility_name %></strong>
                            <% if (credit.booking_ref) { %><span class="small">Booking <code><%= credit.booking_ref %></code></span><% } %>
                            <span class="d-block small">Payment ID: <code><%= credit.payment_reference || 'Not recorded' %></code></span>
                            <span class="d-block">£<%= (credit.remaining_pence / 100).toFixed(2) %> available of £<%= (credit.amount_pence / 100).toFixed(2) %> credited</span>
                            <span class="d-block small text-muted"><%= credit.days_remaining %> <%= credit.days_remaining === 1 ? 'day' : 'days' %> remaining (rounded up). Expires <time data-local-time datetime="<%= new Date(credit.expires_at).toISOString() %>"><%= new Date(credit.expires_at).toISOString() %></time>.</span>
                            <span class="badge badge-<%= credit.refundable ? 'info' : 'secondary' %>"><%= credit.refundable ? 'Refundable' : 'Non-refundable' %></span>
                            <% if (credit.refund_status === 'pending') { %>
                                <div class="alert alert-warning mt-2 mb-0" role="status">
                                    <strong>Refund requested &mdash; pending review</strong>
                                    <p class="mb-0">Your bank refund request for £<%= (credit.remaining_pence / 100).toFixed(2) %> is waiting for an administrator's decision. You do not need to request it again. You can still spend this credit while you wait; the refund amount will reduce accordingly.</p>
                                </div>
                            <% } else if (credit.refund_status === 'approved') { %>
                                <span class="d-block small mt-1">Bank refund accepted: £<%= (credit.refunded_pence / 100).toFixed(2) %>. Deducted from credit; transfer arranged separately.</span>
                            <% } else if (credit.refund_status === 'declined') { %>
                                <span class="d-block small mt-1">Bank refund declined. Any remaining credit can still be used for bookings.</span>
                                <p class="mb-0">Decline reason: <%= credit.decline_comment || 'No reason recorded for this older decision.' %></p>
                            <% } else if (credit.refund_status === 'spent') { %>
                                <span class="d-block small mt-1">Refund request closed: credit fully spent.</span>
                            <% } else if (credit.refundable && credit.remaining_pence > 0) { %>
                                <form method="POST" action="/credits-and-refunds/credit-refunds" class="mt-2">
                                    <input type="hidden" name="credit_guid" value="<%= credit.guid %>">
                                    <button class="btn btn-outline-primary btn-sm" type="submit">Request bank refund of £<%= (credit.remaining_pence / 100).toFixed(2) %></button>
                                </form>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="text-muted mb-0">You have no booking credits.</p>
            <% } %>
        </section>

        <% if (expiredPendingRefunds.length) { %>
            <section class="panel" aria-labelledby="expired-pending-refunds">
                <h2 id="expired-pending-refunds" class="h4">Bank refund requests awaiting review</h2>
                <p>These requests were submitted before their credit expired. They remain pending review, but the credit is no longer available to spend.</p>
                <ul><% expiredPendingRefunds.forEach(request => { %>
                    <li>Booking <code><%= request.booking_ref || 'Opening balance' %></code>: £<%= (request.remaining_pence / 100).toFixed(2) %> bank refund pending review. Payment ID: <code><%= request.payment_reference || 'Not recorded' %></code>.</li>
                <% }) %></ul>
            </section>
        <% } %>

        <section class="panel" aria-labelledby="past-bookings">
            <h2 id="past-bookings" class="h4 mb-1">Bookings eligible for credit requests.</h2>
            <p class="text-muted small">Only bookings that took place within the last <%= creditRequestDays %> days and have not already been credited are eligible for credit requests. Bookings are shown most recent first.</p>
            <p>Credit requests are only accepted for bookings that have passed in the last <%= creditRequestDays %> days. The council incurs a cost when refunding a transaction so we will credit your account. If you could not use the court because of bad weather a bank refund can then be requested in place of the credit applied to your account. If credit has been applied to your account at the discretion of <%= organisationName %>, this may not be refundable.</p>
            <% if (requested) { %><div class="alert alert-success" role="status">Your credit request has been submitted. Pending requests are shown below. Approved bookings no longer appear here; any available credit is shown above.</div><% } %>
            <% if (error === 'invalid-reason') { %><div class="alert alert-danger" role="alert">Please select Weather or Other as the reason for your credit request.</div><% } %>
            <% if (error === 'description-required') { %><div class="alert alert-danger" role="alert">Please provide a description for Other requests. Descriptions must be no more than 500 characters.</div><% } %>
            <% if (error === 'not-eligible') { %><div class="alert alert-danger" role="alert">That booking can't be put forward for credit. It must be a paid booking that ended within the last <%= creditRequestDays %> days with no earlier request.</div><% } %>
            <% if (past.length) { %>
                <ul class="list-unstyled mb-0">
                    <% past.forEach(booking => { %>
                        <li class="booking-item is-past">
                            <span class="badge badge-when badge-secondary">Past</span>
                            <strong><%= booking.facility_name %></strong> · <%= booking.option_name %> · <%= booking.sport_name %> <span class="text-muted small">Ref <code><%= booking.booking_ref %></code></span><br>
                            <time data-local-start datetime="<%= new Date(booking.starts_at).toISOString() %>"><%= new Date(booking.starts_at).toISOString() %></time>
                            to <time data-local-end datetime="<%= new Date(booking.ends_at).toISOString() %>"><%= new Date(booking.ends_at).toISOString() %></time>
                            <span class="d-block small"><%= paymentText(booking) %></span>
                            <span class="d-block small">Payment ID: <code><%= booking.payment_reference || 'Not recorded' %></code></span>
                            <span class="d-block text-muted small"><%= booking.address %>, <%= booking.postcode %></span>
                            <% if (booking.credit_request_status === 'pending') { %>
                                <span class="badge badge-warning mt-1"><%= booking.credit_request_reason === 'discretionary' ? 'Other (discretionary)' : 'Weather' %> credit requested, waiting for a decision</span>
                            <% } else if (booking.credit_request_status === 'declined') { %>
                                <span class="badge badge-secondary mt-1">Credit request declined</span>
                                <p class="mb-0">Decline reason: <%= booking.credit_request_decline_comment || 'No reason recorded for this older decision.' %></p>
                            <% } else if (booking.amount_paid_pence > 0) { %>
                                <details class="mt-2">
                                    <summary class="small">Request credit</summary>
                                    <form class="mt-2" method="POST" action="/credits-and-refunds/credit-requests" data-credit-request>
                                        <input type="hidden" name="booking_guid" value="<%= booking.guid %>">
                                        <div class="form-group mb-2">
                                            <label class="small mb-1" for="reason-<%= booking.guid %>">Reason for requesting credit</label>
                                            <select class="form-control form-control-sm" id="reason-<%= booking.guid %>" name="reason" required>
                                                <option value="weather">Weather</option>
                                                <option value="discretionary">Other</option>
                                            </select>
                                        </div>
                                        <p class="small mb-2">For Other, describe the problem that meant the court could not be used. Requests are reviewed at the administrator's discretion.</p>
                                        <div class="form-group mb-2" data-other-description hidden>
                                            <label class="small mb-1" for="note-<%= booking.guid %>">Description (required for Other)</label>
                                            <textarea class="form-control form-control-sm" id="note-<%= booking.guid %>" name="note" rows="2" maxlength="500"></textarea>
                                        </div>
                                        <button class="btn btn-outline-primary btn-sm" type="submit">Request credit</button>
                                    </form>
                                </details>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="text-muted mb-0">No uncredited bookings in the last <%= creditRequestDays %> days.</p>
            <% } %>
        </section>
    </main>

    <script>
        document.querySelectorAll('[data-credit-request]').forEach(function (form) {
            var reason = form.querySelector('[name="reason"]');
            var note = form.querySelector('[name="note"]');
            var description = form.querySelector('[data-other-description]');
            function updateReason() {
                var weather = reason.value === 'weather';
                note.required = !weather;
                description.hidden = weather;
                note.disabled = weather;
            }
            reason.addEventListener('change', updateReason);
            updateReason();
        });
        var format = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
        var timeOnly = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
        document.querySelectorAll('[data-local-start]').forEach(function (time) {
            var instant = new Date(time.dateTime);
            if (Number.isFinite(instant.getTime())) time.textContent = format.format(instant);
        });
        document.querySelectorAll('[data-local-end]').forEach(function (time) {
            var instant = new Date(time.dateTime);
            if (Number.isFinite(instant.getTime())) time.textContent = timeOnly.format(instant);
        });
    </script>
</body>

</html>
