<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facilities | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"
        integrity="sha384-wvfXpqpZZVQGK6TAh5PVlGOfQNHSoD2xbE+QkPxCAFlNEevoEH3Sl0sibVcOQVnN" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <style>
        main .facility-details-fields .form-control { max-width: none; }
        main .admin-facility-card {
            border-color: var(--camden-border);
            border-top: 4px solid var(--camden-navy);
            border-radius: 0 !important;
            box-shadow: none !important;
        }
        [data-facility-edit] > summary { padding-right: 7rem; }
        [data-facility-delete-name] { position: absolute; top: 1.5rem; right: 1rem; }
        [data-facility-edit-feedback] {
            display: inline-block;
            vertical-align: middle;
            width: 12rem;
            max-width: 100%;
            height: 1.5rem;
        }
        [data-facility-edit-feedback] > output {
            font-size: 0.75rem;
            line-height: 1.4;
            padding: 0.125rem 0.375rem !important;
            white-space: nowrap;
        }
        .admin-facility-card:has(> [data-facility-edit]:not([open])) { padding: 0.75rem 1rem !important; }
        #add-facility-panel:not([open]) { padding: 0.75rem 1rem !important; }
        [data-facility-edit]:not([open]) > summary,
        #add-facility-panel:not([open]) > summary { min-height: 1.75rem; margin-bottom: 0 !important; }
        [data-facility-edit]:not([open]) [data-facility-edit-feedback] { height: 1.5rem !important; }
        .admin-facility-card:has(> [data-facility-edit]:not([open])) > [data-facility-delete-name] {
            top: 0.625rem !important;
            right: 1rem !important;
        }
    </style>
</head>

<body class="bg-light">
    <a class="skip-link" href="#add-facility-section">Skip to add facility form</a>
    <a class="skip-link" href="#facility-directory">Skip to facility directory</a>
    <%- include('partials/navigation') %>
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1">Facilities</h1>
                <p class="text-muted mb-0">Manage facilities and their booking arrangements</p>
            </div>
        </header>

        <div class="admin-save-feedback mb-4">
            <p class="alert text-muted mb-0" data-admin-save-placeholder>You can add, remove, and edit facilities here. Assign sports and configure booking arrangements for each facility.</p>
        </div>
        <div class="row">
            <section id="add-facility-section" tabindex="-1" class="col-12 mb-4" aria-labelledby="add-facility-heading">
                <details id="add-facility-panel" class="admin-disclosure bg-white border rounded shadow-sm p-4" data-editor-disclosure>
                    <summary class="admin-card-summary"><h2 id="add-facility-heading" class="h5 d-inline mb-0">Add facility</h2></summary>
                    <%- include('partials/facility-form', { facility: {} }) %>
                </details>
            </section>

            <section id="facility-directory" tabindex="-1" class="col-12" aria-labelledby="facility-list-heading" data-facilities-directory>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 id="facility-list-heading" class="h5 mb-0">Directory</h2>
                    <span class="badge badge-secondary" data-facility-count><%= facilities.length %></span>
                </div>
                <output class="sr-only" data-facility-feedback aria-live="polite" aria-atomic="true"></output>
                <div class="alert alert-danger" data-facility-error role="alert" tabindex="-1" hidden></div>
                <div data-facility-list>
                <% if (facilities.length) { %>
                    <% facilities.forEach(facility => { %>
                        <article id="facility-<%= facility.guid %>" class="admin-facility-card bg-white rounded shadow-sm p-4 mb-3 position-relative" tabindex="-1" data-facility-guid="<%= facility.guid %>" data-facility-name="<%= facility.name %>">
                            <details class="admin-disclosure" data-facility-edit data-editor-disclosure>
                                <summary class="admin-card-summary">
                                    <h3 class="h5 d-inline mb-0 text-break"><%= facility.name %></h3>
                                    <span data-facility-edit-feedback class="ml-3"></span>
                                </summary>
                                <%- include('partials/facility-form', { facility }) %>
                                <% if (facility.courses.length) { %>
                                <section class="admin-form-section mt-4 mb-0" aria-labelledby="facility-courses-heading-<%= facility.guid %>">
                                    <h4 id="facility-courses-heading-<%= facility.guid %>" class="admin-form-section-title">Courses (<%= facility.courses.length %>)</h4>
                                    <ul class="list-group list-group-flush">
                                        <% facility.courses.forEach(course => { %>
                                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                                <span><%= course.name %></span>
                                                <% if (isAdmin || (locals.can && locals.can('courses.manage'))) { %>
                                                <form method="POST" action="/admin/facilities/courses/destroy">
                                                    <input type="hidden" name="guid" value="<%= course.guid %>">
                                                    <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Delete <%= course.name %>">
                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                                <% } %>
                                            </li>
                                        <% }); %>
                                    </ul>
                                    <% if (isAdmin || (locals.can && locals.can('courses.manage'))) { %>
                                    <a class="btn btn-outline-secondary btn-sm mt-3" href="/admin/courses">Manage courses</a>
                                    <% } %>
                                </section>
                                <% } %>
                            </details>
                            <%# Last in tab order so the destructive action isn't the first stop; shown top right %>
                            <form method="POST" action="/admin/facilities/destroy" data-facility-delete-name="<%= facility.name %>">
                                <input type="hidden" name="guid" value="<%= facility.guid %>">
                                <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Delete facility: <%= facility.name %>">Delete facility</button>
                            </form>
                        </article>
                    <% }); %>
                <% } else { %>
                    <p class="text-muted border-top pt-3">No facilities have been added.</p>
                <% } %>
                </div>
            </section>
        </div>
    </main>
    <script>
        document.querySelectorAll('[data-facility-form]').forEach(form => {
            const bookingModes = form.querySelectorAll('[name="booking_mode"]');
            const externalBookingField = form.querySelector('.external-booking-field');
            const externalBookingUrl = form.querySelector('[name="external_booking_url"]');
            const openingHours = form.querySelector('[name="opening_hours_template_guid"]');
            const bookingLimit = form.querySelector('[name="max_resident_bookings"]');
            const activities = Array.from(form.querySelectorAll('[name="sport_guids"]'));
            const submit = form.querySelector('button[type="submit"]');

            function validateActivities() {
                if (activities.length) {
                    activities[0].setCustomValidity(activities.some(activity => activity.checked)
                        ? '' : 'Select at least one activity.');
                } else {
                    submit.disabled = true;
                }
            }

            activities.forEach(activity => activity.addEventListener('change', validateActivities));
            validateActivities();

            function updateBookingFields() {
                const usesExternalSite = new FormData(form).get('booking_mode') === 'external';
                externalBookingField.hidden = !usesExternalSite;
                externalBookingUrl.required = usesExternalSite;
                openingHours.closest('.form-group').hidden = usesExternalSite;
                bookingLimit.closest('.form-group').hidden = usesExternalSite;
            }

            bookingModes.forEach(control => control.addEventListener('change', updateBookingFields));
            updateBookingFields();
        });
    </script>
</body>

</html>