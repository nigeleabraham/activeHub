<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courses | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
</head>

<body class="bg-light">
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1">Courses</h1>
                <p class="text-muted mb-0">Manage courses offered at facilities</p>
            </div>
            <%- include('partials/navigation') %>
        </header>

        <section aria-labelledby="course-list-heading">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 id="course-list-heading" class="h5 mb-0">Directory</h2>
                    <span class="badge badge-secondary" data-course-count><%= totalCourses %></span>
                </div>
                <% if (courseGroups.length) { %>
                    <% courseGroups.forEach(group => { %>
                        <article id="facility-<%= group.guid %>" class="bg-white border rounded shadow-sm p-4 mb-3" data-course-facility>
                            <h3 class="h5 mb-1"><%= group.name %></h3>
                            <p class="text-muted mb-3"><%= group.address %>, <%= group.postcode %></p>
                            <div data-course-list>
                            <% if (group.courses.length) { %>
                                <div class="list-group list-group-flush">
                                    <% group.courses.forEach(course => { %>
                                        <div class="list-group-item px-0" data-course-guid="<%= course.guid %>" data-course-name="<%= course.name %>">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center">
                                                <div class="mr-3">
                                                    <span><%= course.name %></span>
                                                    <% if (course.description) { %>
                                                        <p class="text-muted small mb-0"><%= course.description %></p>
                                                    <% } %>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <button class="btn btn-outline-secondary btn-sm mr-2" type="button" data-edit-toggle aria-expanded="false" aria-controls="edit-course-<%= course.guid %>" aria-label="Edit <%= course.name %>">Edit</button>
                                                    <form method="POST" action="/admin/courses/destroy">
                                                        <input type="hidden" name="guid" value="<%= course.guid %>">
                                                        <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Delete <%= course.name %>">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                            <div id="edit-course-<%= course.guid %>" data-edit-panel hidden>
                                                        <form class="mt-3 p-3 border rounded" method="POST" action="/admin/courses/update" data-editor-label="Edit <%= course.name %>">
                                                            <input type="hidden" name="guid" value="<%= course.guid %>">
                                                            <div class="form-group">
                                                                <label for="edit-course-name-<%= course.guid %>">Course name</label>
                                                                <input class="form-control" id="edit-course-name-<%= course.guid %>" name="name" type="text" maxlength="160" value="<%= course.name %>" required>
                                                            </div>
                                                            <div class="form-group">
                                                                <label for="edit-course-description-<%= course.guid %>">Description <small class="text-muted">Optional</small></label>
                                                                <textarea class="form-control" id="edit-course-description-<%= course.guid %>" name="description" rows="3" maxlength="10000"><%= course.description || '' %></textarea>
                                                            </div>
                                                            <button class="btn btn-primary btn-sm" type="submit">Save changes</button>
                                                            <button class="btn btn-outline-secondary btn-sm ml-1" type="button" data-cancel-edit>Cancel</button>
                                                        </form>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <p class="text-muted mb-0">No courses are attached to this facility.</p>
                            <% } %>
                            </div>
                            <div class="alert alert-success" data-course-feedback role="status" aria-live="polite" aria-atomic="true" hidden></div>
                            <div class="alert alert-danger" data-course-error role="alert" tabindex="-1" hidden></div>
                            <div class="d-flex align-items-center mt-3" style="gap: 0.5rem;">
                                <button class="btn btn-outline-secondary btn-sm flex-shrink-0" type="button" data-edit-toggle aria-expanded="false" aria-controls="add-course-panel-<%= group.guid %>">Add course</button>
                                <div class="flex-grow-1 d-flex align-items-center" data-course-add-feedback style="height: 4.5rem; min-width: 0; overflow: auto;"></div>
                            </div>
                            <div id="add-course-panel-<%= group.guid %>" data-edit-panel hidden>
                                <form id="add-course-<%= group.guid %>" method="POST" action="/admin/courses" data-editor-success-inline>
                                    <input type="hidden" name="facility_guid" value="<%= group.guid %>">
                                    <div class="form-group">
                                        <label for="add-course-name-<%= group.guid %>">Course name</label>
                                        <input class="form-control" id="add-course-name-<%= group.guid %>" name="name" type="text" maxlength="160" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="add-course-description-<%= group.guid %>">Description <small class="text-muted">Optional</small></label>
                                        <textarea class="form-control" id="add-course-description-<%= group.guid %>" name="description" rows="3" maxlength="10000"></textarea>
                                    </div>
                                    <button class="btn btn-primary btn-sm" type="submit">Add course</button>
                                </form>
                            </div>
                        </article>
                    <% }); %>
                <% } else { %>
                    <p class="text-muted border-top pt-3">Add a facility to start organizing courses.</p>
                <% } %>
        </section>
    </main>
</body>

</html>
