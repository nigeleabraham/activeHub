<% const configuring = activePage === 'court-configuration'; %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= configuring ? 'Court configuration' : 'Bookings management' %> | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <%- include('partials/booking-flow-styles') %>
</head>

<body class="bg-light">
    <%- include('partials/navigation') %>
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1"><%= configuring ? 'Court configuration' : 'Bookings management' %></h1>
                <p class="text-muted mb-0"><%= configuring ? 'Configure bookable courts, shared resources and sport booking months' : 'Make and manage bookings for any profile' %></p>
            </div>
        </header>

        <%- include('partials/booking-messages') %>

        <p class="mb-4">
            <% if (configuring) { %>
                <a href="/admin/bookings">Go to bookings management</a> to make bookings and manage existing slots.
            <% } else { %>
                <a href="/admin/court-configuration">Go to court configuration</a> to manage courts, resources and sport booking months.
            <% } %>
        </p>

        <% if (facilities.length) { %>
            <% facilities.forEach(facility => { %>
                <section class="bg-white border rounded shadow-sm p-4 mb-4" aria-labelledby="facility-<%= facility.guid %>">
                    <header class="mb-4">
                        <h2 id="facility-<%= facility.guid %>" class="h4 mb-1"><%= facility.name %></h2>
                        <p class="text-muted mb-0"><%= facility.address %>, <%= facility.postcode %></p>
                    </header>

                    <% if (configuring) { %>
                    <div>
                        <div class="mb-4">
                            <details>
                                <summary class="h5 mb-3">Sport booking months</summary>
                                <p class="small text-muted">Set the allowed booking months for each sport at this site. Applies every year to all courts for that sport, using UK booking dates. Other sites are unaffected. Existing bookings are not cancelled.</p>
                                <% facility.sports.forEach(sport => { %>
                                    <form class="border rounded p-3 mb-3" method="POST" action="/admin/bookings/sports/months">
                                        <input type="hidden" name="facility_guid" value="<%= facility.guid %>">
                                        <input type="hidden" name="sport_guid" value="<%= sport.guid %>">
                                        <fieldset>
                                            <legend class="h6">Allowed booking months for <%= sport.name %></legend>
                                            <% ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'].forEach((month, index) => { %>
                                                <label class="mr-3"><input type="checkbox" name="allowed_months" value="<%= index + 1 %>" <%= sport.allowed_months.includes(index + 1) ? 'checked' : '' %>> <%= month %></label>
                                            <% }) %>
                                        </fieldset>
                                        <p class="small text-muted">All months are enabled by default. Clear all to disable new bookings for this sport at this site year-round.</p>
                                        <button class="btn btn-primary btn-sm" type="submit">Save months</button>
                                    </form>
                                <% }) %>
                                <% if (!facility.sports.length) { %>
                                    <p class="text-muted">Assign sports to this facility to configure their booking months.</p>
                                <% } %>
                            </details>
                        </div>
                        <div class="mb-4">
                            <details>
                                <summary class="h5 mb-3">Resources (<%= facility.resources.length %>)</summary>
                                <p class="text-muted small">Resources are exclusive booking claims. Courts sharing a resource block each other. Use a separate resource for each court-pair conflict so unrelated courts remain available.</p>
                                <form class="form-inline mb-3" method="POST" action="/admin/bookings/resources">
                                    <input type="hidden" name="facility_guid" value="<%= facility.guid %>">
                                    <label class="sr-only" for="new-resource-<%= facility.guid %>">Resource name</label>
                                    <input class="form-control form-control-sm mr-2 mb-2" id="new-resource-<%= facility.guid %>" name="name" type="text" maxlength="120" placeholder="Resource name" required>
                                    <button class="btn btn-primary btn-sm mb-2" type="submit">Add resource</button>
                                </form>
                                <% if (facility.resources.length) { %>
                                    <ul class="list-group list-group-flush">
                                        <% facility.resources.forEach(resource => { %>
                                            <li class="list-group-item px-0">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span><%= resource.name %> <small class="text-muted">Claimed by <%= resource.claim_count %></small></span>
                                                    <div class="d-flex">
                                                        <details class="mr-2">
                                                            <summary class="btn btn-outline-secondary btn-sm">Edit</summary>
                                                            <form class="mt-2" method="POST" action="/admin/bookings/resources/update">
                                                                <input type="hidden" name="facility_guid" value="<%= facility.guid %>">
                                                                <input type="hidden" name="guid" value="<%= resource.guid %>">
                                                                <label class="sr-only" for="resource-name-<%= resource.guid %>">Resource name</label>
                                                                <input class="form-control form-control-sm mb-2" id="resource-name-<%= resource.guid %>" name="name" type="text" maxlength="120" value="<%= resource.name %>" required>
                                                                <button class="btn btn-primary btn-sm" type="submit">Save</button>
                                                                <button class="btn btn-outline-secondary btn-sm ml-1" type="button" data-cancel-edit>Cancel</button>
                                                            </form>
                                                        </details>
                                                        <form method="POST" action="/admin/bookings/resources/destroy">
                                                            <input type="hidden" name="facility_guid" value="<%= facility.guid %>">
                                                            <input type="hidden" name="resource_guid" value="<%= resource.guid %>">
                                                            <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Delete <%= resource.name %>">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </li>
                                        <% }); %>
                                    </ul>
                                <% } else { %>
                                    <p class="text-muted">No resources defined yet.</p>
                                <% } %>
                            </details>
                        </div>

                        <div class="mb-4">
                            <details>
                                <summary class="h5 mb-3">Bookable courts (<%= facility.options.length %>)</summary>
                                <% if (facility.sports.length && facility.resources.length) { %>
                                    <form class="border rounded p-3 mb-4" method="POST" action="/admin/bookings/options">
                                        <input type="hidden" name="facility_guid" value="<%= facility.guid %>">
                                        <h3 class="h6">Add bookable court</h3>
                                        <div class="form-group">
                                            <label for="option-name-<%= facility.guid %>">Court name</label>
                                            <input class="form-control form-control-sm" id="option-name-<%= facility.guid %>" name="name" type="text" maxlength="120" required>
                                        </div>
                                        <div class="form-group">
                                            <label for="option-sport-<%= facility.guid %>">Sport</label>
                                            <select class="form-control form-control-sm" id="option-sport-<%= facility.guid %>" name="sport_guid" required>
                                                <% facility.sports.forEach(sport => { %>
                                                    <option value="<%= sport.guid %>"><%= sport.name %></option>
                                                <% }); %>
                                            </select>
                                        </div>
                                        <fieldset class="form-group">
                                            <legend class="col-form-label">Resources this court occupies</legend>
                                            <% facility.resources.forEach(resource => { %>
                                                <div class="custom-control custom-checkbox">
                                                    <input class="custom-control-input" id="new-option-<%= facility.guid %>-<%= resource.guid %>" name="resource_guids" type="checkbox" value="<%= resource.guid %>">
                                                    <label class="custom-control-label" for="new-option-<%= facility.guid %>-<%= resource.guid %>"><%= resource.name %></label>
                                                </div>
                                            <% }); %>
                                        </fieldset>
                                        <p class="small text-muted">This court uses the selected sport's allowed booking months at this site. Configure these under Sport booking months.</p>
                                        <button class="btn btn-primary btn-sm" type="submit">Add court</button>
                                    </form>
                                <% } else if (!facility.sports.length) { %>
                                    <p class="text-muted">Assign at least one sport to this facility before adding bookable courts.</p>
                                <% } else { %>
                                    <p class="text-muted">Add resources before configuring bookable courts.</p>
                                <% } %>

                                <% if (facility.options.length) { %>
                                    <% facility.options.forEach(option => { %>
                                        <article class="border-top py-3">
                                            <div class="d-flex flex-wrap justify-content-between align-items-start">
                                                <div>
                                                    <h3 class="h6 mb-1"><%= option.name %> <span class="text-muted font-weight-normal">· <%= option.sport_name %></span></h3>
                                                    <p class="small text-muted mb-2">Uses: <%= option.resources.map(resource => resource.name).join(', ') %></p>
                                                </div>
                                                <form method="POST" action="/admin/bookings/options/destroy">
                                                    <input type="hidden" name="facility_guid" value="<%= facility.guid %>">
                                                    <input type="hidden" name="option_guid" value="<%= option.guid %>">
                                                    <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Delete <%= option.name %>">Delete</button>
                                                </form>
                                            </div>
                                            <details>
                                                <summary class="btn btn-outline-secondary btn-sm">Edit court claims</summary>
                                                <form class="mt-3 p-3 border rounded" method="POST" action="/admin/bookings/options/update">
                                                    <input type="hidden" name="facility_guid" value="<%= facility.guid %>">
                                                    <input type="hidden" name="guid" value="<%= option.guid %>">
                                                    <div class="form-group">
                                                        <label for="edit-option-name-<%= option.guid %>">Court name</label>
                                                        <input class="form-control form-control-sm" id="edit-option-name-<%= option.guid %>" name="name" type="text" maxlength="120" value="<%= option.name %>" required>
                                                    </div>
                                                    <div class="form-group">
                                                        <label for="edit-option-sport-<%= option.guid %>">Sport</label>
                                                        <select class="form-control form-control-sm" id="edit-option-sport-<%= option.guid %>" name="sport_guid" required>
                                                            <% facility.sports.forEach(sport => { %>
                                                                <option value="<%= sport.guid %>" <%= sport.guid === option.sport_guid ? 'selected' : '' %>><%= sport.name %></option>
                                                            <% }); %>
                                                        </select>
                                                    </div>
                                                    <fieldset class="form-group">
                                                        <legend class="col-form-label">Resources this court occupies</legend>
                                                        <% facility.resources.forEach(resource => { %>
                                                            <div class="custom-control custom-checkbox">
                                                                <input class="custom-control-input" id="edit-option-<%= option.guid %>-<%= resource.guid %>" name="resource_guids" type="checkbox" value="<%= resource.guid %>" <%= option.resources.some(claimed => claimed.guid === resource.guid) ? 'checked' : '' %>>
                                                                <label class="custom-control-label" for="edit-option-<%= option.guid %>-<%= resource.guid %>"><%= resource.name %></label>
                                                            </div>
                                                        <% }); %>
                                                    </fieldset>
                                                    <button class="btn btn-primary btn-sm" type="submit">Save court</button>
                                                    <button class="btn btn-outline-secondary btn-sm ml-1" type="button" data-cancel-edit>Cancel</button>
                                                </form>
                                            </details>
                                        </article>
                                    <% }); %>
                                <% } %>
                            </details>
                        </div>
                    </div>

                    <% } else { %>
                        <%- include('partials/booking-flow', { facility }) %>
                    <% } %>
                </section>
            <% }); %>
        <% } else { %>
            <p class="text-muted border-top pt-3">No in-app-managed facilities are available.</p>
        <% } %>
    </main>
    <% if (!configuring) { %>
        <%- include('partials/booking-flow-script') %>
    <% } %>
</body>

</html>
