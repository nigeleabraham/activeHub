<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Credit refunds | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
</head>
<body class="bg-light">
    <%- include('partials/navigation') %>
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1">Credit refunds</h1>
                <p class="text-muted">Requests to transfer refundable booking credit to a bank account.</p>
            </div>
        </header>
        <p>Accepting deducts the current remaining credit immediately. Arrange the bank transfer outside ActiveHub. Pending amounts may decrease if credit is spent; fully spent requests close automatically.</p>
        <% if (decision) { %>
            <div class="alert alert-success" role="status"><%= decision === 'approved' ? 'Refund accepted and the remaining credit deducted. Arrange the transfer outside ActiveHub; the exact amount is recorded below.' : 'Refund declined. The credit remains available for bookings.' %></div>
        <% } %>
        <% if (declineError) { %><div class="alert alert-danger" role="alert">Enter a decline comment of 1 to 500 characters. This will be visible to the requestor.</div><% } %>
        <% if (error) { %>
            <div class="alert alert-warning" role="alert">This request can no longer be actioned. It may already be decided or its credit fully spent.</div>
        <% } %>
        <% const money = pence => '£' + (pence / 100).toFixed(2); %>
        <% for (const pending of [true, false]) { %>
            <% const items = requests.filter(request => (request.status === 'pending') === pending); %>
            <section class="mb-4" aria-labelledby="<%= pending ? 'pending-refunds' : 'closed-refunds' %>">
                <h2 class="h5" id="<%= pending ? 'pending-refunds' : 'closed-refunds' %>"><%= pending ? 'Pending review' : 'History' %> (<%= items.length %>)</h2>
                <% if (items.length) { %>
                    <div class="table-responsive bg-white border rounded">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Booking</th><th>Requested by</th><th>Requested amount</th><th>Remaining credit</th><th>Outcome</th></tr></thead>
                            <tbody>
                                <% items.forEach(request => { %>
                                    <tr>
                                        <td><code><%= request.booking_ref || 'Opening balance' %></code><br><span class="small">Payment ID: <code><%= request.payment_reference || 'Not recorded' %></code></span><br><%= request.facility_name %></td>
                                        <td><%= request.profile_name %><br><span class="small"><%= request.profile_email %></span></td>
                                        <td><%= money(request.requested_pence) %></td>
                                        <td><%= money(request.remaining_pence) %><% if (request.expired) { %><br><span class="badge badge-warning">Expired for spending; refund review still allowed</span><% } %></td>
                                        <td>
                                            <% if (pending) { %>
                                                <form method="POST" action="/admin/credit-refunds/decide">
                                                    <input type="hidden" name="request_guid" value="<%= request.guid %>">
                                                    <button class="btn btn-outline-primary btn-sm mb-1" type="submit" name="decision" value="approve" data-confirm="Accept the refund and deduct the remaining credit? The amount may have decreased since this page loaded. Check the accepted amount in History before arranging the transfer.">Accept refund</button>
                                                </form>
                                                <form method="POST" action="/admin/credit-refunds/decide">
                                                    <input type="hidden" name="request_guid" value="<%= request.guid %>">
                                                    <label class="small d-block" for="decline-<%= request.guid %>">Decline reason (visible to requestor)</label>
                                                    <textarea class="form-control form-control-sm mb-1" id="decline-<%= request.guid %>" name="decline_comment" maxlength="500" rows="2" required></textarea>
                                                    <button class="btn btn-outline-secondary btn-sm mb-1" type="submit" name="decision" value="decline">Decline</button>
                                                </form>
                                            <% } else { %>
                                                <strong><%= request.status === 'approved' ? 'Accepted ' + money(request.refunded_pence) : request.status === 'cancelled' ? 'Cancelled: profile deleted' : request.status === 'spent' ? 'Closed: credit fully spent' : 'Declined' %></strong>
                                                <% if (request.decided_by_name) { %><br><span class="small">By <%= request.decided_by_name %></span><% } %>
                                                <% if (request.status === 'declined') { %><p class="small mb-0">Reason: <%= request.decline_comment || 'No reason recorded for this older decision.' %></p><% } %>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %><p class="text-muted"><%= pending ? 'No refunds are waiting for review.' : 'No completed refund requests.' %></p><% } %>
            </section>
        <% } %>
    </main>
    <script>
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                var button = event.submitter;
                if (button && button.dataset.confirm && !window.confirm(button.dataset.confirm)) event.preventDefault();
            });
        });
    </script>
</body>
</html>
