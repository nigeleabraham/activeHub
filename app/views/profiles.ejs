<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profiles | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
</head>

<body class="bg-light">
    <%- include('partials/navigation') %>
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1">Profiles</h1>
                <p class="text-muted mb-0">Manage who can sign in and their assigned roles</p>
            </div>
        </header>

        <% const messages = {
            'invalid-profile': 'Enter a name, a valid email address and choose only listed roles.',
            'duplicate-email': 'A profile with that email address already exists.',
            'save-failed': 'The profile could not be saved. Please try again.',
            'last-administrator': 'There must always be at least one Administrator.',
            'delete-self': 'You cannot delete the profile you are signed in with.'
        }; %>
        <% if (error && messages[error]) { %>
            <div class="alert alert-danger" role="alert"><%= messages[error] %></div>
        <% } %>

        <div class="admin-save-feedback mb-4">
            <p class="alert text-muted mb-0" data-admin-save-placeholder>You can add, remove, and edit profiles here. Assigning Administrator automatically allows switching to every role, including roles added later; other role boxes need not be selected. Deleting a profile removes future bookings, cancels pending credit and refund requests, and voids unused credit. History is retained.</p>
        </div>

        <section class="mb-3" aria-labelledby="add-profile-heading">
            <div class="bg-white border rounded shadow-sm p-3">
                <h2 id="add-profile-heading" class="h5 mb-2">Add profile</h2>
                <form class="form-row align-items-end" method="POST" action="/admin/profiles" data-editor-label="Add profile">
                    <div class="form-group col-md">
                        <label for="profile-name">Name</label>
                        <input class="form-control" id="profile-name" name="name" type="text" maxlength="120" required>
                    </div>
                    <div class="form-group col-md">
                        <label for="profile-email">Email address</label>
                        <input class="form-control" id="profile-email" name="email" type="email" maxlength="254" required>
                    </div>
                    <fieldset class="form-group col-md-3">
                        <legend class="h6">Roles</legend>
                        <p class="small text-muted">Resident is always assigned. Select any additional roles.</p>
                        <% roles.forEach((role, index) => { %>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="profile-role-<%= index %>" name="roles" value="<%= role %>"<%= role === 'Resident' ? ' checked disabled' : '' %>>
                                <label class="form-check-label" for="profile-role-<%= index %>"><%= role %></label>
                            </div>
                        <% }); %>
                    </fieldset>
                    <div class="form-group col-md-auto">
                        <button class="btn btn-primary" type="submit">Add profile</button>
                    </div>
                </form>
            </div>
        </section>

        <section aria-labelledby="profiles-list-heading" data-profiles-directory>
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 id="profiles-list-heading" class="h5 mb-0">Directory</h2>
                <span class="badge badge-secondary" data-profile-count><%= profiles.length %></span>
            </div>
            <div class="sr-only" data-profile-feedback role="status" aria-live="polite" aria-atomic="true"></div>
            <div class="alert alert-danger" data-profile-error role="alert" tabindex="-1" hidden></div>
            <div data-profile-list>
            <% if (profiles.length) { %>
            <article class="bg-white border rounded shadow-sm p-4 mb-3">
                <ul class="list-group list-group-flush">
                    <% profiles.forEach(profile => { %>
                        <li id="profile-<%= profile.guid %>" class="list-group-item px-0" data-profile-guid="<%= profile.guid %>" data-profile-name="<%= profile.name %>">
                            <div class="d-flex flex-wrap justify-content-between align-items-center" style="row-gap: 1rem;">
                                <div class="mr-3 flex-grow-1" style="min-width: 0;">
                                    <div class="d-flex align-items-center" style="min-width: 0;">
                                    <span class="text-break mr-3"><%= profile.name %></span>
                                    <div data-profile-edit-feedback class="d-flex align-items-center flex-grow-1" style="height: 4.5rem; min-width: 0; overflow: auto;"></div>
                                    </div>
                                    <% (profile.roles || [profile.role]).forEach(role => { %><span class="badge badge-secondary ml-1"><%= role %></span><% }); %>
                                    <p class="text-muted small mb-0 text-break"><%= profile.email %></p>
                                    <p class="small mb-0">Booking credit: £<%= (profile.credit_pence / 100).toFixed(2) %></p>
                                </div>
                                <div class="d-flex align-items-center flex-shrink-0">
                                    <button class="btn btn-outline-secondary btn-sm mr-2" type="button" data-edit-toggle aria-expanded="false" aria-controls="edit-profile-<%= profile.guid %>">Edit</button>
                                    <% if (profile.guid !== currentProfile.guid) { %>
                                    <form method="POST" action="/admin/profiles/destroy">
                                        <input type="hidden" name="guid" value="<%= profile.guid %>">
                                        <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Delete <%= profile.name %>">Delete</button>
                                    </form>
                                    <% } %>
                                </div>
                            </div>
                            <div id="edit-profile-<%= profile.guid %>" data-edit-panel hidden>
                                <form class="mt-3 p-3 border rounded" method="POST" action="/admin/profiles/update">
                                    <input type="hidden" name="guid" value="<%= profile.guid %>">
                                    <div class="form-group">
                                        <label for="edit-profile-name-<%= profile.guid %>">Name</label>
                                        <input class="form-control" id="edit-profile-name-<%= profile.guid %>" name="name" type="text" maxlength="120" value="<%= profile.name %>" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="edit-profile-email-<%= profile.guid %>">Email address</label>
                                        <input class="form-control" id="edit-profile-email-<%= profile.guid %>" name="email" type="email" maxlength="254" value="<%= profile.email %>" required>
                                    </div>
                                    <fieldset class="form-group">
                                        <legend class="h6">Roles</legend>
                                        <p class="small text-muted">Resident is always assigned. Select any additional roles.</p>
                                        <% roles.forEach((role, index) => { %>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="edit-profile-role-<%= profile.guid %>-<%= index %>" name="roles" value="<%= role %>"<%= role === 'Resident' ? ' checked disabled' : (profile.roles || [profile.role]).includes(role) ? ' checked' : '' %>>
                                                <label class="form-check-label" for="edit-profile-role-<%= profile.guid %>-<%= index %>"><%= role %></label>
                                            </div>
                                        <% }); %>
                                    </fieldset>
                                    <button class="btn btn-primary btn-sm" type="submit">Save changes</button>
                                    <button class="btn btn-outline-secondary btn-sm ml-1" type="button" data-cancel-edit>Cancel</button>
                                </form>
                            </div>
                        </li>
                    <% }); %>
                </ul>
            </article>
            <% } else { %>
                <div class="alert alert-info mb-0">No profiles have been added yet.</div>
            <% } %>
            </div>
        </section>
    </main>
</body>

</html>
