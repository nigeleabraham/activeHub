<style>
    .admin-editor-status { display: block; width: 100%; margin: 0.5rem 0; }
    [data-description-mode][value="standard"]:disabled + [data-description-standard-label] { text-decoration: line-through; }
    .admin-editor-dirty { border-left: 4px solid #805b00 !important; padding-left: 0.75rem; }
    .admin-unsaved-dialog { max-width: 34rem; width: calc(100% - 2rem); border: 2px solid #212529; padding: 1.5rem; }
    .admin-unsaved-dialog::backdrop { background: rgba(0, 0, 0, 0.45); }
    .admin-unsaved-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem; }
    .admin-course-card, .admin-facility-card { border: 1px solid #dee2e6; }
    .admin-course-highlight, .admin-facility-saved { outline: 3px solid transparent; animation: admin-course-saved 1.5s ease-in-out; }
    .admin-facility-saved { animation-name: admin-facility-saved; }
    .admin-run-card { border: 1px solid #dee2e6; }
    .admin-run-saved { animation: admin-run-border-saved 1.5s ease-in-out; }
    .admin-run-deleting { animation: none; border-color: #dc3545; box-shadow: 0 0 0 3px #dc3545; }
    .admin-text-saved { outline: 3px solid transparent; animation: admin-text-saved 1.5s ease-in-out; }
    .admin-text-saved [data-text-save-feedback] { animation: admin-text-notice-saved 1.5s ease-in-out both; }
    .admin-facility-saved [data-admin-save-confirmation] { transition: none; animation: admin-text-notice-saved 1.5s ease-in-out both; }
    [data-course-feedback], [data-admin-save-confirmation] { transition: opacity 0.5s ease-out; }
    [data-text-save-feedback][hidden] { display: none !important; }
    [data-text-save-slot] {
        display: inline-block;
        vertical-align: middle;
        width: 12rem;
        max-width: 100%;
        height: 1.5rem;
    }
    [data-text-save-feedback] {
        transition: none;
        font-size: 0.75rem;
        line-height: 1.4;
        padding: 0.125rem 0.375rem;
        white-space: nowrap;
    }
    .admin-notice-fading { opacity: 0; }
    .admin-save-feedback { display: grid; }
    .admin-save-feedback > * { grid-area: 1 / 1; margin-bottom: 0; }
    [data-course-add-feedback] > .alert {
        display: flex;
        align-items: center;
        width: 100%;
        min-height: 2.0625rem;
        font-size: 0.875rem;
        line-height: 1.5;
    }
    @keyframes admin-course-saved {
        0%, 25% { border-color: #28a745; outline-color: #28a745; }
        100% { border-color: #dee2e6; outline-color: transparent; }
    }
    @keyframes admin-run-border-saved {
        0%, 25% { border-color: #28a745; box-shadow: 0 0 0 2px #28a745; }
        100% { border-color: #dee2e6; box-shadow: 0 0 0 2px transparent; }
    }
    @keyframes admin-text-saved {
        0%, 25% { outline-color: #28a745; }
        100% { outline-color: transparent; }
    }
    @keyframes admin-facility-saved {
        0%, 25% { border-color: #28a745; outline-color: #28a745; }
        100% { border-color: var(--camden-border); border-top-color: var(--camden-navy); outline-color: transparent; }
    }
    @keyframes admin-text-notice-saved {
        0%, 25% { opacity: 1; }
        100% { opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
        .admin-course-highlight, .admin-facility-saved { animation: none; border-color: #28a745; outline-color: #28a745; }
        .admin-run-saved { animation: none; border-color: #28a745; box-shadow: 0 0 0 2px #28a745; }
        .admin-text-saved { animation: none; outline-color: #28a745; }
        .admin-text-saved [data-text-save-feedback] { animation: none; }
        .admin-facility-saved [data-admin-save-confirmation] { animation: none; }
        [data-course-feedback], [data-admin-save-confirmation], [data-text-save-feedback] { transition: none; }
    }
    @media (max-width: 575.98px) {
        .admin-unsaved-actions { flex-direction: column; }
    }
</style>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const navigationGroups = Array.from(document.querySelectorAll('.admin-navigation-group'));
    navigationGroups.forEach(group => {
        group.addEventListener('toggle', () => {
            if (group.open) navigationGroups.forEach(other => { if (other !== group) other.open = false; });
        });
    });
    document.addEventListener('click', event => {
        if (!event.target.closest('.admin-navigation')) navigationGroups.forEach(group => { group.open = false; });
    });
    document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const group = event.target.closest('.admin-navigation-group');
        if (group?.open) {
            group.open = false;
            group.querySelector('summary').focus();
            event.preventDefault();
        }
    });
    document.documentElement.setAttribute('data-admin-editors', '');
    const entries = [];
    let active = null;
    let saving = false;
    let leaving = false;
    let continuation = null;
    let returnFocus = null;
    let bypassSubmit = null;
    let submitContinuation = null;
    const noticeTimers = new WeakMap();

    function resetNoticeFade(notice, fade, onHidden, visibleMs = 4000) {
        const previous = noticeTimers.get(notice);
        if (previous) previous.forEach(timer => window.clearTimeout(timer));
        noticeTimers.delete(notice);
        notice.classList.remove('admin-notice-fading');
        if (!fade) return;
        const fadeTimer = window.setTimeout(() => notice.classList.add('admin-notice-fading'), visibleMs);
        const hideTimer = window.setTimeout(() => {
            notice.classList.remove('admin-notice-fading');
            noticeTimers.delete(notice);
            if (onHidden) onHidden();
            else notice.hidden = true;
        }, visibleMs + 500);
        noticeTimers.set(notice, [fadeTimer, hideTimer]);
    }

    const pageUrl = new URL(window.location.href);
    const createdSectionId = pageUrl.searchParams.get('admin_saved') === 'section-created'
        ? pageUrl.searchParams.get('section_created') : null;
    const sportScrollKey = 'activehub-sport-save-scroll';
    const savedSportScroll = pageUrl.pathname === '/admin/sports' && pageUrl.searchParams.get('admin_saved') === 'sport-updated'
        ? window.sessionStorage.getItem(sportScrollKey) : null;
    window.sessionStorage.removeItem(sportScrollKey);
    const savedSportPanels = window.sessionStorage.getItem('activehub-sport-save-panels');
    window.sessionStorage.removeItem('activehub-sport-save-panels');
    if (savedSportScroll !== null && savedSportPanels) {
        const openSports = JSON.parse(savedSportPanels);
        document.querySelectorAll('[data-sport-details]').forEach(details => {
            details.open = openSports.includes(details.closest('[data-sport-guid]').dataset.sportGuid);
        });
    }
    if (savedSportScroll !== null && Number.isFinite(Number(savedSportScroll))) {
        window.addEventListener('load', () => {
            window.requestAnimationFrame(() => window.scrollTo(0, Number(savedSportScroll)));
        }, { once: true });
    }
    const successMessages = {
        '1': 'Changes saved successfully.',
        'facility-updated': 'Changes saved successfully.',
        'facility-created': 'Facility added successfully.',
        'template-created': 'Opening hours template added successfully.',
        'template-updated': 'Changes saved successfully.',
        'sport-updated': 'Changes saved successfully.',
        'section-created': 'Section added successfully.',
        'profile-created': 'Profile added successfully.',
        'profile-updated': 'Changes saved successfully.',
        'course-created': 'Course added successfully.',
        'course-updated': 'Course updated successfully.',
        'course-deleted': 'Course deleted successfully.'
    };
    const successKey = pageUrl.searchParams.get('admin_saved');
    if (Object.hasOwn(successMessages, successKey)) {
        const notice = document.createElement('output');
        notice.className = 'alert alert-success';
        if (['course-updated', 'course-deleted'].includes(successKey)) notice.classList.add('sr-only');
        notice.setAttribute('data-admin-save-confirmation', '');
        notice.setAttribute('aria-live', 'polite');
        notice.textContent = successMessages[successKey];
        const main = document.querySelector('main');
        const header = main?.querySelector('header');
        const target = document.getElementById(pageUrl.hash.slice(1));
        const facilityCard = successKey === 'facility-updated' && pageUrl.pathname === '/admin/facilities'
            ? document.getElementById(pageUrl.searchParams.get('admin_saved_target')) : null;
        const sportRow = successKey === 'sport-updated' && pageUrl.pathname === '/admin/sports'
            ? document.getElementById(pageUrl.searchParams.get('admin_saved_target')) : null;
        const templateCard = successKey === 'template-updated' && pageUrl.pathname === '/admin/opening-hours'
            ? document.getElementById(pageUrl.searchParams.get('admin_saved_target')) : null;
        const profileRow = successKey === 'profile-updated' && pageUrl.pathname === '/admin/profiles'
            ? document.getElementById(pageUrl.searchParams.get('admin_saved_target')) : null;
        const savedItem = facilityCard?.matches('article') ? facilityCard
            : sportRow?.matches('[data-sport-guid]') ? sportRow
            : templateCard?.matches('article') ? templateCard
            : profileRow?.matches('[data-profile-guid]') ? profileRow : null;
        const card = successKey.startsWith('course-') ? target?.closest('article') : null;
        if (successKey === 'section-created' && target?.matches('[data-sport-section-details]')) {
            notice.classList.add('d-inline-block', 'mb-0', 'py-1', 'px-2', 'small');
            target.querySelector('[data-section-add-feedback]').append(notice);
            resetNoticeFade(notice, true);
        } else if (savedItem) {
            const name = sportRow ? sportRow.dataset.sportName
                : profileRow ? profileRow.dataset.profileName : savedItem.querySelector('h3').textContent.trim();
            notice.textContent = facilityCard ? 'Facility updated.' : `"${name}" updated successfully.`;
            notice.classList.add('mb-0', 'py-1', 'px-2', 'small');
            savedItem.querySelector(profileRow ? '[data-profile-edit-feedback]' : sportRow ? '[data-sport-edit-feedback]'
                : templateCard ? '[data-template-edit-feedback]' : '[data-facility-edit-feedback]').append(notice);
            if (!facilityCard) resetNoticeFade(notice, true, () => { notice.style.visibility = 'hidden'; });
            window.addEventListener('load', () => {
                notice.tabIndex = -1;
                notice.focus({ preventScroll: true });
                if (!sportRow || savedSportScroll === null) notice.scrollIntoView({ block: 'nearest' });
                if (facilityCard) {
                    facilityCard.classList.add('admin-facility-saved');
                    const finishFeedback = () => {
                        notice.style.visibility = 'hidden';
                        facilityCard.classList.remove('admin-facility-saved');
                        facilityCard.removeEventListener('animationend', onFeedbackEnd);
                    };
                    const onFeedbackEnd = event => {
                        if (event.target === facilityCard && event.animationName === 'admin-facility-saved') finishFeedback();
                    };
                    facilityCard.addEventListener('animationend', onFeedbackEnd);
                    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                        window.setTimeout(finishFeedback, 1500);
                    }
                }
            }, { once: true });
        } else if (card) {
            card.prepend(notice);
            if (target === card && !notice.classList.contains('sr-only')) {
                window.addEventListener('load', () => {
                    notice.tabIndex = -1;
                    notice.focus();
                }, { once: true });
            }
        } else if (main?.querySelector('[data-admin-save-placeholder]')) {
            const placeholder = main.querySelector('[data-admin-save-placeholder]');
            placeholder.style.visibility = 'hidden';
            placeholder.after(notice);
            resetNoticeFade(notice, true, () => {
                notice.style.visibility = 'hidden';
                placeholder.style.visibility = '';
            });
        } else if (header) header.after(notice);
        else if (main) main.prepend(notice);
        pageUrl.searchParams.delete('admin_saved');
        pageUrl.searchParams.delete('admin_saved_target');
        pageUrl.searchParams.delete('section_created');
        window.history.replaceState(window.history.state, '', pageUrl.href);
    }

    const dialog = document.createElement('dialog');
    dialog.className = 'admin-unsaved-dialog';
    dialog.setAttribute('aria-labelledby', 'admin-unsaved-title');
    dialog.setAttribute('aria-describedby', 'admin-unsaved-description');
    dialog.innerHTML = `
        <h2 id="admin-unsaved-title" class="h5">Unsaved changes</h2>
        <p id="admin-unsaved-description"></p>
        <div class="admin-unsaved-actions">
            <button type="button" class="btn btn-outline-secondary" data-unsaved-keep autofocus>Keep editing</button>
            <button type="button" class="btn btn-outline-danger" data-unsaved-discard>Discard changes</button>
            <button type="button" class="btn btn-primary" data-unsaved-save>Save and continue</button>
        </div>`;
    document.body.append(dialog);
    const saveChoice = dialog.querySelector('[data-unsaved-save]');
    const keepChoice = dialog.querySelector('[data-unsaved-keep]');
    const discardChoice = dialog.querySelector('[data-unsaved-discard]');
    const mobileActions = window.matchMedia('(max-width: 575.98px)');
    function updateActionOrder() {
        const focused = document.activeElement;
        dialog.querySelector('.admin-unsaved-actions').replaceChildren(...(mobileActions.matches
            ? [saveChoice, keepChoice, discardChoice]
            : [keepChoice, discardChoice, saveChoice]));
        if (dialog.open && dialog.contains(focused)) focused.focus();
    }
    mobileActions.addEventListener('change', updateActionOrder);
    updateActionOrder();

    function snapshot(form) {
        return JSON.stringify(Array.from(form.elements)
            .filter(field => field.name && !['submit', 'button', 'reset'].includes(field.type))
            .map(field => [field.name, field.type, field.value, field.checked, field.disabled,
                field.tagName === 'SELECT' ? Array.from(field.selectedOptions, option => option.value) : null]));
    }

    function dirty(entry) {
        return snapshot(entry.form) !== entry.baseline;
    }

    function update(entry) {
        const changed = dirty(entry);
        entry.form.classList.toggle('admin-editor-dirty', changed);
        entry.status.textContent = changed ? 'Unsaved changes' : '';
    }

    function close(entry) {
        if (entry.form.hasAttribute('data-profile-editor') && entry.panel && !entry.panel.hidden) {
            entry.form.dispatchEvent(new CustomEvent('profile-editor-toggle', { detail: { open: false } }));
        }
        if (entry.panel) {
            entry.panel.hidden = true;
            entry.toggle.setAttribute('aria-expanded', 'false');
            if (entry.toggle.hasAttribute('data-hide-when-editing')) entry.toggle.hidden = false;
        } else if (entry.details) {
            entry.details.open = false;
        }
    }

    function open(entry) {
        const profileEditor = entry.form.hasAttribute('data-profile-editor');
        const scrollPosition = profileEditor ? { left: window.scrollX, top: window.scrollY, behavior: 'instant' } : null;
        for (const other of entries) {
            if (other !== entry) close(other);
        }
        active = entry;
        if (profileEditor) entry.form.dispatchEvent(new CustomEvent('profile-editor-toggle', { detail: { open: true } }));
        if (entry.panel) {
            entry.panel.hidden = false;
            entry.toggle.setAttribute('aria-expanded', 'true');
            if (entry.toggle.hasAttribute('data-hide-when-editing')) entry.toggle.hidden = true;
        } else if (entry.details) {
            entry.details.open = true;
        }
        for (let parent = entry.form.parentElement; parent; parent = parent.parentElement) {
            if (parent.tagName === 'DETAILS') parent.open = true;
        }
        entry.form.querySelector('input:not([type="hidden"]), select, textarea')?.focus(profileEditor ? { preventScroll: true } : undefined);
        if (profileEditor) window.scrollTo(scrollPosition);
    }

    function reset(entry) {
        entry.form.reset();
        if (entry.form.hasAttribute('data-profile-editor')) entry.form.dispatchEvent(new Event('profile-reset', { bubbles: true }));
        else entry.form.querySelectorAll('input, select, textarea').forEach(field =>
            field.dispatchEvent(new Event('change', { bubbles: true })));
        entry.error.hidden = true;
        update(entry);
    }

    function navigate(url) {
        const destination = new URL(url, window.location.href);
        const hashOnly = destination.origin === window.location.origin &&
            destination.pathname === window.location.pathname &&
            destination.search === window.location.search &&
            destination.hash !== window.location.hash;
        leaving = true;
        window.location.assign(destination.href);
        if (hashOnly) window.location.reload();
    }

    function proceed(action, savedLocation) {
        if (action.kind === 'reorder') {
            void reorderCards(action);
            return;
        }
        if (savedLocation) {
            const destination = new URL(action.kind === 'navigate' ? action.url : savedLocation, window.location.href);
            if (destination.origin === window.location.origin && destination.pathname.startsWith('/admin/')) {
                if (!destination.searchParams.has('admin_saved')) destination.searchParams.set('admin_saved', '1');
            }
            if (action.kind === 'editor') destination.hash = action.entry.form.id;
            return navigate(destination.href);
        }
        if (action.kind === 'navigate') return navigate(action.url);
        if (action.kind === 'faq-disclosure') {
            if (active && (action.details.contains(active.form) || action.open)) {
                close(active);
                active = null;
            }
            action.details.open = action.open;
            action.details.querySelector(':scope > summary').focus();
            return;
        }
        if (action.kind === 'editor') {
            const entry = entries.find(item => item.form.id === action.entry.form.id);
            if (entry) return open(entry);
            return;
        }
        if (action.kind === 'close') {
            if (!active) return;
            close(active);
            (active.toggle || active.form.querySelector('input:not([type="hidden"]), select, textarea'))?.focus({ preventScroll: true });
            active = null;
        } else if (action.kind === 'collapse') {
            if (active) close(active);
            active = null;
            close(action.entry);
            action.entry.toggle.focus({ preventScroll: true });
        } else if (action.kind === 'submit') {
            if (!action.form.isConnected && action.form.action.endsWith('/courses/faqs/destroy')) {
                const guid = action.form.elements.namedItem('guid').value;
                const replacement = Array.from(document.querySelectorAll('form[action="/admin/courses/faqs/destroy"]'))
                    .find(form => form.elements.namedItem('guid').value === guid);
                if (!replacement) return;
                action = { ...action, form: replacement, submitter: document.querySelector(`button[form="${replacement.id}"]`) };
            }
            if (!action.form.isConnected && action.form.action.endsWith('/courses/destroy')) {
                const guid = action.form.elements.namedItem('guid').value;
                const replacement = Array.from(document.querySelectorAll('form[action="/admin/courses/destroy"]'))
                    .find(form => form.elements.namedItem('guid').value === guid);
                if (!replacement) return;
                action = { ...action, form: replacement, submitter: replacement.querySelector('button[type="submit"]') };
            }
            bypassSubmit = action.form;
            action.form.requestSubmit(action.submitter || undefined);
            bypassSubmit = null;
        }
    }

    function guard(action) {
        if (saving) return;
        if (!active || !dirty(active)) return proceed(action);
        continuation = action;
        returnFocus = document.activeElement;
        dialog.querySelector('#admin-unsaved-description').textContent =
            `You have unsaved changes in "${active.label}". Save them before continuing, or discard them.`;
        saveChoice.hidden = false;
        dialog.showModal();
    }

    function dismiss() {
        dialog.close();
        continuation = null;
        returnFocus?.focus();
    }

    function showError(entry, message) {
        entry.error.textContent = message;
        entry.error.hidden = false;
    }

<%- include('deletion-animation') %>

    async function refreshSections(form, response, type = 'section') {
        const faq = type === 'faq';
        const panel = form.closest(faq ? '[data-sport-faq-details]' : '[data-sport-section-details]');
        const rowSelector = faq ? '[data-faq-card]' : '[data-course-section-card]';
        const row = form.closest(rowSelector);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const replacement = faq
            ? html.getElementById(panel.closest('[data-sport-faq-card]').id)?.querySelector('[data-sport-faq-details]')
            : html.getElementById(panel.id);
        const id = row.getAttribute(faq ? 'data-faq-card' : 'data-course-section-card');
        if (!replacement || Array.from(replacement.querySelectorAll(rowSelector))
            .some(item => item.getAttribute(faq ? 'data-faq-card' : 'data-course-section-card') === id)) {
            throw new Error(`The ${type} deletion could not be confirmed. Check the list before retrying.`);
        }
        const index = Array.from(panel.querySelectorAll(rowSelector)).indexOf(row);
        await animateDeletion(row);
        panel.replaceChildren(...replacement.childNodes);
        for (let i = entries.length - 1; i >= 0; i--) {
            if (!entries[i].form.isConnected) {
                if (active === entries[i]) active = null;
                entries.splice(i, 1);
            }
        }
        initializeEditors();
        panel.querySelector(`[data-${type}-delete-feedback]`).textContent = faq ? 'FAQ removed successfully.' : 'Section removed successfully.';
        const remaining = panel.querySelectorAll(rowSelector);
        const target = remaining[Math.min(index, remaining.length - 1)]?.querySelector('summary') ||
            panel.querySelector(faq ? '[data-faq-add]' : 'form[action$="/course-sections/create"]').parentElement.querySelector('summary');
        target.focus({ preventScroll: true });
    }

    async function refreshDirectory(form, response, type = 'sport') {
        const directory = form.closest(`[data-${type === 'facility' ? 'facilities' : `${type}s`}-directory]`);
        const rowSelector = `[data-${type}-guid]`;
        const listSelector = `[data-${type}-list]`;
        const countSelector = `[data-${type}-count]`;
        const row = form.closest(rowSelector);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const newList = html.querySelector(listSelector);
        const count = html.querySelector(countSelector);
        const serverError = html.querySelector('main [role="alert"]');
        if (serverError && !serverError.hidden && serverError.textContent.trim()) {
            throw new Error(serverError.textContent.trim());
        }
        if (!newList || !count || Array.from(newList.querySelectorAll(rowSelector))
            .some(item => item.getAttribute(`data-${type}-guid`) === row.getAttribute(`data-${type}-guid`))) {
            throw new Error(`The ${type} deletion could not be confirmed. Check the directory before retrying.`);
        }
        const rows = Array.from(directory.querySelectorAll(rowSelector));
        const index = rows.indexOf(row);
        if (type === 'sport') {
            const deletionNotice = document.createElement('output');
            deletionNotice.className = 'alert alert-danger mb-0';
            deletionNotice.setAttribute('data-sport-delete-feedback', '');
            deletionNotice.setAttribute('aria-live', 'polite');
            deletionNotice.textContent = 'Sport deleted.';
            row.querySelector('[data-sport-edit-feedback]').replaceChildren(deletionNotice);
            row.classList.add('admin-sport-deleting');
        }
        await animateDeletion(row, type === 'sport' ? 1000 : 0, type === 'sport' ? 800 / 0.75 : 800);
        row.remove();
        directory.querySelector(countSelector).textContent = count.textContent;
        if (!directory.querySelector(rowSelector)) directory.querySelector(listSelector).replaceWith(newList);
        for (let i = entries.length - 1; i >= 0; i--) {
            if (!entries[i].form.isConnected) {
                if (active === entries[i]) active = null;
                entries.splice(i, 1);
            }
        }
        directory.querySelector(`[data-${type}-feedback]`).textContent = `"${row.getAttribute(`data-${type}-name`)}" deleted successfully.`;
        const remaining = directory.querySelectorAll(rowSelector);
        const target = remaining[Math.min(index, remaining.length - 1)]?.querySelector('form[action$="/destroy"] button')
            || (type === 'sport' ? document.querySelector('#add-sport-panel > summary')
                : type === 'facility' ? document.querySelector('#add-facility-panel > summary')
                : type === 'profile' ? document.getElementById('profile-name')
                    : document.querySelector('#add-template-panel > summary'));
        target.focus({ preventScroll: true });
    }

<%- include('card-order-behaviour') %>

    const textSaveCleanups = new WeakMap();

    function finishTextSave(entry) {
        textSaveCleanups.get(entry.details)?.();
        close(entry);
        if (active === entry) active = null;
        let notice = entry.toggle.querySelector('[data-text-save-feedback]');
        if (!notice) {
            notice = document.createElement('output');
            notice.className = 'alert alert-success d-inline-block mb-0';
            notice.setAttribute('data-text-save-feedback', '');
            notice.setAttribute('aria-live', 'polite');
            entry.toggle.querySelector('[data-text-save-slot]').append(notice);
        }
        const action = new URL(entry.form.action).pathname;
        notice.textContent = action === '/admin/sports/update' ? 'Sport details updated.'
            : action === '/admin/sports/course-defaults' ? 'Course defaults saved.' : 'FAQs saved.';
        notice.hidden = false;
        resetNoticeFade(notice, false);
        entry.details.classList.remove('admin-text-saved');
        void entry.details.offsetWidth;
        entry.toggle.focus({ preventScroll: true });
        entry.details.scrollIntoView({ block: 'nearest', behavior: 'instant' });
        entry.details.classList.add('admin-text-saved');
        let reducedMotionTimer;
        const finishFeedback = () => {
            window.clearTimeout(reducedMotionTimer);
            notice.hidden = true;
            entry.details.classList.remove('admin-text-saved');
            entry.details.removeEventListener('animationend', onFeedbackEnd);
            textSaveCleanups.delete(entry.details);
        };
        const onFeedbackEnd = event => {
            if (event.target === entry.details && event.animationName === 'admin-text-saved') finishFeedback();
        };
        textSaveCleanups.set(entry.details, finishFeedback);
        entry.details.addEventListener('animationend', onFeedbackEnd);
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            reducedMotionTimer = window.setTimeout(finishFeedback, 1500);
        }
    }

    async function animateRunDeletion(run) {
        run.classList.remove('admin-run-saved');
        run.querySelector('[data-edit-panel]').hidden = true;
        run.querySelector('[data-edit-toggle]').setAttribute('aria-expanded', 'false');
        run.scrollIntoView({ block: 'nearest', behavior: 'instant' });
        run.classList.add('admin-run-deleting');
        await new Promise(resolve => window.setTimeout(resolve, 1200));
        await animateDeletion(run);
    }

    function focusSavedCourseRun(row, runGuid) {
        const run = Array.from(row.querySelectorAll('[data-admin-run-card]'))
            .find(item => item.dataset.runGuid === runGuid);
        if (!run) throw new Error('The saved course run could not be found. Check the directory before retrying.');
        for (let parent = run.parentElement; parent; parent = parent.parentElement) {
            if (parent.tagName === 'DETAILS') parent.open = true;
        }
        run.querySelector('[data-edit-panel]').hidden = true;
        const toggle = run.querySelector('[data-edit-toggle]');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus({ preventScroll: true });
        run.scrollIntoView({ block: 'nearest' });
        run.classList.add('admin-run-saved');
        window.setTimeout(() => run.classList.remove('admin-run-saved'), 1500);
    }

    async function refreshCourses(form, response) {
        const card = form.closest('[data-course-facility]');
        const sourceRow = form.closest('[data-course-guid]');
        const runDelete = new URL(form.action).pathname === '/admin/courses/runs/destroy';
        const sourceRun = runDelete ? form.closest('[data-admin-run-card]') : null;
        const runIndex = sourceRun ? Array.from(sourceRow.querySelectorAll('[data-admin-run-card]')).indexOf(sourceRun) : -1;
        const name = form.elements.namedItem('name')?.value.trim() || sourceRow?.dataset.courseName;
        const operation = !runDelete && new URL(form.action).pathname.endsWith('/destroy') ? 'deleted'
            : sourceRow ? 'updated' : 'added';
        const oldRows = Array.from(card.querySelectorAll('[data-course-guid]'));
        const openGroups = new Set(Array.from(card.querySelectorAll('[data-course-sport-group]'))
            .filter(group => group.querySelector('[data-course-group-disclosure]')?.open)
            .map(group => group.dataset.courseSportGroup));
        const index = oldRows.indexOf(sourceRow);
        const previousGuids = new Set(oldRows.map(row => row.dataset.courseGuid));
        const runSave = ['/admin/courses/runs', '/admin/courses/runs/update'].includes(new URL(form.action).pathname);
        const previousRunGuids = new Set(Array.from(sourceRow?.querySelectorAll('[data-admin-run-card]') || [])
            .map(run => run.dataset.runGuid));
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const updatedCard = html.getElementById(card.id);
        const newList = updatedCard?.querySelector('[data-course-list]');
        const count = html.querySelector('[data-course-count]');
        if (!newList || !count) throw new Error('The course change could not be confirmed. Check the directory before retrying.');
        newList.querySelectorAll('[data-course-sport-group]').forEach(group => {
            if (openGroups.has(group.dataset.courseSportGroup)) group.querySelector('[data-course-group-disclosure]').open = true;
        });
        if (runDelete) {
            const updatedRow = Array.from(newList.querySelectorAll('[data-course-guid]'))
                .find(row => row.dataset.courseGuid === sourceRow.dataset.courseGuid);
            if (!updatedRow || Array.from(updatedRow.querySelectorAll('[data-admin-run-card]'))
                .some(run => run.dataset.runGuid === sourceRun.dataset.runGuid)) {
                throw new Error('The run deletion could not be confirmed. Check the runs before retrying.');
            }
            await animateRunDeletion(sourceRun);
        } else if (operation === 'deleted' && sourceRow) {
            if (Array.from(newList.querySelectorAll('[data-course-guid]'))
                .some(row => row.dataset.courseGuid === sourceRow.dataset.courseGuid)) {
                throw new Error('The course deletion could not be confirmed. Check the directory before retrying.');
            }
            const deletionNotice = document.createElement('output');
            deletionNotice.className = 'alert alert-danger mb-0';
            deletionNotice.setAttribute('data-course-delete-feedback', '');
            deletionNotice.setAttribute('aria-live', 'polite');
            deletionNotice.textContent = `"${sourceRow.dataset.courseName}" deleted successfully.`;
            deletionNotice.title = deletionNotice.textContent;
            sourceRow.querySelector('[data-course-delete-slot]').append(deletionNotice);
            await animateDeletion(sourceRow);
        }
        const notice = card.querySelector('[data-course-feedback]');
        // Keep the live region mounted when replacing the course rows.
        card.querySelector('[data-course-list]').before(notice);
        card.querySelector('[data-course-list]').replaceWith(newList);
        document.querySelector('[data-course-count]').textContent = count.textContent;
        for (let i = entries.length - 1; i >= 0; i--) {
            if (!entries[i].form.isConnected) {
                if (active === entries[i]) active = null;
                entries.splice(i, 1);
            }
        }
        initializeEditors();
        const rows = Array.from(newList.querySelectorAll('[data-course-guid]'));
        const changed = operation === 'added'
            ? rows.find(row => !previousGuids.has(row.dataset.courseGuid))
            : rows.find(row => row.dataset.courseGuid === sourceRow?.dataset.courseGuid);
        const savedRunGuid = runSave && (form.elements.namedItem('guid')?.value ||
            Array.from(changed?.querySelectorAll('[data-admin-run-card]') || [])
                .find(run => !previousRunGuids.has(run.dataset.runGuid))?.dataset.runGuid);
        if (runSave && (!changed || !savedRunGuid)) {
            throw new Error('The saved course run could not be found. Check the directory before retrying.');
        }
        if (changed) {
            const groupDisclosure = changed.closest('[data-course-group-disclosure]');
            if (groupDisclosure) groupDisclosure.open = true;
            if (operation === 'added') {
                changed.classList.add('admin-course-highlight');
                window.setTimeout(() => changed.classList.remove('admin-course-highlight'), 1500);
            }
        }
        const message = document.createElement('span');
        message.textContent = runDelete ? 'Course run deleted.' : `"${name}" ${operation} successfully.`;
        notice.replaceChildren(message);
        notice.hidden = false;
        notice.classList.toggle('sr-only', operation !== 'added');
        resetNoticeFade(notice, operation === 'added');
        card.querySelector('[data-course-error]').hidden = true;
        if (operation === 'added') {
            const entry = entries.find(item => item.form === form);
            form.reset();
            entry.baseline = snapshot(form);
            card.querySelector('[data-course-add-feedback]').append(notice);
            notice.classList.add('mb-0', 'py-1', 'px-2', 'small');
            form.inert = false;
            form.querySelector('[name="name"]').focus({ preventScroll: true });
        } else if (runDelete) {
            const runsDisclosure = changed.querySelector('[data-course-runs-disclosure]');
            for (let parent = runsDisclosure; parent; parent = parent.parentElement) {
                if (parent.tagName === 'DETAILS') parent.open = true;
            }
            const remainingRuns = Array.from(changed.querySelectorAll('[data-admin-run-card]'));
            const target = remainingRuns[Math.min(runIndex, remainingRuns.length - 1)]?.querySelector('[data-edit-toggle]')
                || runsDisclosure.querySelector('[data-edit-toggle]');
            target.focus({ preventScroll: true });
            target.scrollIntoView({ block: 'nearest' });
        } else if (runSave) {
            focusSavedCourseRun(changed, savedRunGuid);
        } else {
            const targetRow = changed || rows[Math.min(index, rows.length - 1)];
            if (operation === 'updated' && changed) {
                changed.querySelector('[data-course-edit]').open = false;
            }
            const groupDisclosure = targetRow?.closest('[data-course-group-disclosure]');
            if (groupDisclosure) groupDisclosure.open = true;
            const focusTarget = targetRow?.querySelector(operation === 'deleted'
                ? 'form[action="/admin/courses/destroy"] button' : '[data-course-edit] > summary')
                || card.querySelector('#add-course-panel-directory > summary');
            focusTarget?.focus({ preventScroll: true });
            if (operation === 'updated') targetRow?.scrollIntoView({ block: 'nearest', behavior: 'instant' });
            if (operation === 'updated' && changed) {
                changed.classList.add('admin-course-highlight');
                window.setTimeout(() => changed.classList.remove('admin-course-highlight'), 1500);
            }
        }
    }

    function highlightAddedCard(addedCard) {
        addedCard.classList.add('section-added-highlight');
        addedCard.querySelector('summary').focus({ preventScroll: true });
        addedCard.scrollIntoView({ block: 'nearest' });
        window.setTimeout(() => addedCard.classList.remove('section-added-highlight'), 1500);
    }

    async function refreshFaqs(entry, response) {
        const card = entry.form.closest('[data-sport-faq-card]');
        const editing = entry.form.hasAttribute('data-faq-edit');
        const moving = entry.form.hasAttribute('data-faq-move');
        const adding = !editing && !moving;
        const previousGuids = new Set(Array.from(card.querySelectorAll('[data-faq-card]'),
            row => row.dataset.faqCard));
        const guid = editing ? entry.form.elements.namedItem('guid').value : null;
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const updatedCard = html.getElementById(card.id);
        const list = updatedCard?.querySelector('[data-sport-faq-list]');
        const count = updatedCard?.querySelector('[data-sport-faq-count]');
        const addedCards = adding && list
            ? Array.from(list.querySelectorAll('[data-faq-card]')).filter(row => !previousGuids.has(row.dataset.faqCard))
            : [];
        if (!list || !count || (editing && !Array.from(list.querySelectorAll('form[data-faq-edit]')).some(form =>
            form.elements.namedItem('guid').value === guid)) || (adding && addedCards.length !== 1)) {
            throw new Error('The FAQ change could not be confirmed. Check the list before retrying.');
        }
        card.querySelector('[data-sport-faq-list]').replaceWith(list);
        card.querySelector('[data-sport-faq-count]').replaceWith(count);
        for (let i = entries.length - 1; i >= 0; i--) {
            if (!entries[i].form.isConnected) {
                if (active === entries[i]) active = null;
                entries.splice(i, 1);
            }
        }
        initializeEditors();
        if (editing) {
            entry = entries.find(item => item.form.hasAttribute('data-faq-edit') &&
                item.form.elements.namedItem('guid').value === guid);
            open(entry);
        } else if (moving) {
            entry = entries.find(item => item.form.hasAttribute('data-faq-move') &&
                item.form.closest('[data-sport-faq-card]') === card);
            open(entry);
        } else entry.form.reset();
        const notice = adding ? card.querySelector('[data-faq-add-feedback]')
            : entry.form.querySelector('[data-faq-feedback]');
        notice.textContent = editing ? 'Changes saved successfully.' : moving ? 'FAQ order updated successfully.' : 'FAQ added successfully.';
        notice.hidden = false;
        resetNoticeFade(notice, true);
        entry.form.inert = false;
        if (adding) highlightAddedCard(addedCards[0]);
        else entry.form.querySelector(moving ? '[name="guid"]' : '[name="question"]').focus({ preventScroll: true });
    }

    async function save(entry, submitter) {
        if (!entry.form.reportValidity()) return null;
        const scrollBeforeSave = window.scrollY;
        entry.error.hidden = true;
        const buttons = Array.from(entry.form.querySelectorAll('button, input[type="submit"]'));
        const states = buttons.map(button => button.disabled);
        const submitLabel = submitter?.textContent;
        const data = submitter ? new FormData(entry.form, submitter) : new FormData(entry.form);
        const submittedSnapshot = snapshot(entry.form);
        saving = true;
        entry.form.setAttribute('aria-busy', 'true');
        entry.form.inert = true;
        buttons.forEach(button => { button.disabled = true; });
        entry.status.textContent = 'Saving changes...';
        const courseForm = entry.form.closest('[data-course-facility]');
        if (courseForm && submitter) submitter.textContent = entry.form.action.endsWith('/update') ? 'Saving...' : 'Adding...';
        try {
            const logo = entry.form.hasAttribute('data-admin-logo');
            const file = logo ? data.get('site_logo') : null;
            if (logo && (!file || !file.size || file.size > 512 * 1024)) {
                throw new Error('Choose a PNG, JPEG, WebP or SVG image no larger than 512 KB.');
            }
            const response = await fetch(entry.form.action, {
                method: 'POST',
                body: logo ? file : new URLSearchParams(data),
                headers: logo ? { 'Content-Type': file.type } : {}
            });
            const destination = new URL(response.url);
            if (destination.pathname === '/login' || response.status === 401 || response.status === 403) {
                throw new Error('Your session has ended or you no longer have permission. Your entries are still here; sign in in another tab before trying again.');
            }
            if (!response.ok) {
                if (response.status === 422 && response.headers.get('content-type')?.includes('application/json')) {
                    const problem = await response.json();
                    if (typeof problem.error === 'string') throw new Error(problem.error);
                }
                throw new Error(response.status === 415 ? 'Use a PNG, JPEG, WebP or SVG image.'
                    : response.status === 400
                    ? 'The changes could not be saved. Check the entered values and try again.'
                    : `The save could not be confirmed (HTTP ${response.status}). Your entries have been kept. Check the saved record before retrying.`);
            }
            if (entry.form.hasAttribute('data-profile-editor')) {
                if (!response.headers.get('content-type')?.includes('application/json')) {
                    throw new Error('The save could not be confirmed. Your entries have been kept; check your session before retrying.');
                }
                const result = await response.json();
                if (result.saved !== true || !result.values || typeof result.values !== 'object') {
                    throw new Error('The save could not be confirmed. Your entries have been kept; check the saved record before retrying.');
                }
                Array.from(entry.form.elements).forEach(field => {
                    if (!field.name || !Object.hasOwn(result.values, field.name)) return;
                    const value = result.values[field.name];
                    if (field.type === 'checkbox') field.checked = Array.isArray(value) && value.includes(field.value);
                    else if (field.type === 'radio') field.checked = field.value === (typeof value === 'boolean' ? value ? 'yes' : 'no' : value);
                    else field.value = typeof value === 'boolean' ? value ? 'yes' : 'no' : value ?? '';
                });
                entry.form.dispatchEvent(new Event('profile-reset', { bubbles: true }));
                Array.from(entry.form.elements).forEach(field => {
                    if (['checkbox', 'radio'].includes(field.type)) field.defaultChecked = field.checked;
                    else if (field.tagName === 'SELECT') Array.from(field.options).forEach(option => { option.defaultSelected = option.selected; });
                    else if (field.tagName === 'INPUT' || field.tagName === 'TEXTAREA') field.defaultValue = field.value;
                });
                entry.baseline = snapshot(entry.form);
                entry.form.dispatchEvent(new Event('profile-saved'));
                entry.form.dispatchEvent(new Event('profile-feedback'));
                const notice = entry.form.closest('[data-profile-section]').querySelector('.alert-success');
                resetNoticeFade(notice, true);
                return destination.href;
            }
            if (destination.searchParams.has('error')) {
                const html = new DOMParser().parseFromString(await response.text(), 'text/html');
                const message = html.querySelector('.alert[role="alert"], .alert-danger, .alert-warning')?.textContent.trim();
                throw new Error(message || 'The changes could not be saved. Check the entered values and try again.');
            }
            const ownRoleChanged = new URL(entry.form.action).pathname === '/admin/profiles/update'
                && destination.pathname === '/profile' && destination.searchParams.get('saved') === '1';
            if (!(logo && response.status === 204) && !ownRoleChanged && destination.pathname !== window.location.pathname) {
                throw new Error('The save returned an unexpected page. Your entries have been kept; check your session and the saved record before retrying.');
            }
            if (courseForm) {
                const expected = entry.form.action.endsWith('/update') ? 'course-updated' : 'course-created';
                if (destination.searchParams.get('admin_saved') !== expected) {
                    throw new Error('The course change could not be confirmed. Your entries have been kept; check the directory before retrying.');
                }
                await refreshCourses(entry.form, response);
            }
            if (entry.form.matches('form[action="/admin/courses/faqs/save"], form[action="/admin/sports/course-defaults"], form[action="/admin/sports/update"]')) {
                if (destination.searchParams.get('admin_saved') !== 'sport-updated') {
                    throw new Error('The sport changes could not be confirmed. Check the saved sport before retrying.');
                }
                if (new URL(entry.form.action).pathname === '/admin/sports/update') {
                    const row = entry.form.closest('[data-sport-guid]');
                    const html = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const savedRow = html.getElementById(row.id);
                    if (!savedRow?.dataset.sportName) {
                        throw new Error('The saved sport name could not be confirmed. Check the directory before retrying.');
                    }
                    const name = savedRow.dataset.sportName;
                    row.dataset.sportName = name;
                    row.querySelector('[data-sport-details] > summary h3').textContent = name;
                    entry.form.elements.namedItem('name').value = name;
                    row.querySelector('[data-sport-delete] button').setAttribute('aria-label', `Delete sport: ${name}`);
                    row.querySelectorAll('[data-editor-label]').forEach(form => {
                        if (form === entry.form) form.dataset.editorLabel = `Update ${name} sport title`;
                        else if (form.action.endsWith('/course-defaults')) form.dataset.editorLabel = `${name} course description`;
                        else if (form.action.endsWith('/faqs/save')) form.dataset.editorLabel = `${name} FAQs`;
                    });
                }
                Array.from(entry.form.elements).forEach(field => {
                    if (field.tagName === 'TEXTAREA' || (field.tagName === 'INPUT' && field.name === 'name')) field.defaultValue = field.value;
                });
                entry.baseline = snapshot(entry.form);
                return destination.href;
            }
            const faqForm = entry.form.matches('[data-faq-add], [data-faq-edit], [data-faq-move]');
            if (faqForm) {
                if (destination.searchParams.get('admin_saved') !== '1') {
                    throw new Error('The FAQ change could not be confirmed. Your entries have been kept; check the list before retrying.');
                }
                await refreshFaqs(entry, response);
            }
            entry.baseline = (courseForm || faqForm) && entry.form.isConnected ? snapshot(entry.form) : submittedSnapshot;
            const savedTarget = destination.searchParams.get('admin_saved_target');
            if (['/admin/sports/update', '/admin/sports/course-defaults'].includes(new URL(entry.form.action).pathname) ||
                new URL(entry.form.action).pathname.startsWith('/admin/sports/course-sections/')) {
                window.sessionStorage.setItem(sportScrollKey, String(scrollBeforeSave));
                window.sessionStorage.setItem('activehub-sport-save-panels', JSON.stringify(
                    Array.from(document.querySelectorAll('[data-sport-details][open]'))
                        .map(details => details.closest('[data-sport-guid]').dataset.sportGuid)));
            }
            if (savedTarget) destination.hash = savedTarget;
            return logo ? '/admin/settings?saved=1' : destination.href;
        } catch (error) {
            console.error('Unable to save admin changes', error);
            showError(entry, error instanceof TypeError
                ? 'The save could not be confirmed because of a connection problem. Your entries have been kept. Check the saved record before retrying.'
                : error.message);
            return null;
        } finally {
            saving = false;
            buttons.forEach((button, index) => { button.disabled = states[index]; });
            if (courseForm && submitter) submitter.textContent = submitLabel;
            entry.form.removeAttribute('aria-busy');
            entry.form.inert = false;
            update(entry);
            if (!entry.error.hidden) entry.error.focus();
        }
    }

    function initializeEditors() {
    document.querySelectorAll('[data-card-order-list]').forEach(updateOrderControls);
    document.querySelectorAll('[data-description-sections]').forEach(editor => {
        if (editor.dataset.initialized) return;
        editor.dataset.initialized = 'true';
        const value = editor.querySelector('input[type="hidden"]');
        const rows = editor.querySelector('[data-section-rows]');
        const sync = () => {
            value.value = JSON.stringify(Array.from(rows.children).map(row => ({
                id: row.dataset.sectionId,
                heading: row.querySelector('input').value,
                text: row.querySelector('textarea').value
            })));
            value.dispatchEvent(new Event('input', { bubbles: true }));
        };
        const add = section => {
            const row = document.createElement('div');
            row.className = 'border rounded p-3 mb-3';
            row.dataset.sectionId = section.id;
            for (const [tag, title, content, max] of [
                ['input', 'Section heading (optional)', section.heading, 160],
                ['textarea', 'Section text', section.text, 10000]
            ]) {
                const label = document.createElement('label');
                label.className = 'd-block';
                label.textContent = title;
                const control = document.createElement(tag);
                control.className = 'form-control mb-2';
                control.maxLength = max;
                control.defaultValue = control.value = content;
                if (tag === 'textarea') { control.rows = 4; control.required = true; }
                control.addEventListener('input', sync);
                label.append(control);
                row.append(label);
            }
            for (const [title, action] of [
                ['Move up', () => { if (row.previousElementSibling) rows.insertBefore(row, row.previousElementSibling); }],
                ['Move down', () => { if (row.nextElementSibling) rows.insertBefore(row.nextElementSibling, row); }],
                ['Remove section', () => row.remove()]
            ]) {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'btn btn-outline-secondary btn-sm mr-2';
                button.textContent = title;
                button.addEventListener('click', () => { action(); sync(); });
                row.append(button);
            }
            rows.append(row);
        };
        JSON.parse(value.value).forEach(add);
        const initial = JSON.stringify(Array.from(rows.children).map(row => ({
            id: row.dataset.sectionId, heading: row.querySelector('input').value, text: row.querySelector('textarea').value
        })));
        value.value = initial;
        editor.closest('form').addEventListener('reset', () => {
            rows.replaceChildren();
            JSON.parse(initial).forEach(add);
            value.value = initial;
        });
        editor.querySelector('[data-section-add]').addEventListener('click', () => {
            add({ id: crypto.randomUUID(), heading: '', text: '' });
            sync();
            rows.lastElementChild.querySelector('input').focus();
        });
    });
    // Mirrors partials/faq-answer.ejs so the preview matches what customers see
    function formatDescription(value) {
        const tokens = value.split(/(<\/?(?:bold|ul|bullet|email)>)/);
        const stack = [];
        const tags = new Map();
        const formatting = {
            bold: ['<strong>', '</strong>'],
            ul: ['<u>', '</u>'],
            bullet: ['<ul style="margin: 0; padding-left: 1.5rem;"><li>', '</li></ul>']
        };
        for (let index = 1; index < tokens.length; index += 2) {
            const marker = tokens[index];
            if (!marker.startsWith('</')) {
                stack.push(index);
                continue;
            }
            const previous = stack[stack.length - 1];
            if (!previous || tokens[previous] !== marker.replace('</', '<')) continue;
            stack.pop();
            const name = marker.slice(2, -1);
            if (name !== 'email') {
                tags.set(previous, formatting[name][0]);
                tags.set(index, formatting[name][1]);
                continue;
            }
            const address = tokens[previous + 1].trim();
            if (index === previous + 2 && address.length <= 254 &&
                /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/.test(address)) {
                tags.set(previous, `<a href="mailto:${encodeURIComponent(address)}">`);
                tags.set(index, '</a>');
            }
        }
        const escape = text => text.replace(/[&<>"']/g, character =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
        return tokens.map((token, index) => tags.has(index) ? tags.get(index) : escape(token)).join('');
    }

    document.querySelectorAll('[data-description-editor]').forEach(editor => {
        if (editor.dataset.initialized) return;
        editor.dataset.initialized = 'true';
        const form = editor.closest('form');
        const select = editor.querySelector('[data-description-source]');
        const standardPanel = editor.querySelector('[data-description-standard]');
        const ownPanel = editor.querySelector('[data-description-own]');
        const ownText = ownPanel.querySelector('textarea');
        const standardMode = editor.querySelector('[data-description-mode][value="standard"]');
        const customMode = editor.querySelector('[data-description-mode][value="own"]');
        let customText = customMode.checked ? ownText.value : null;
        let wasStandard = standardMode.checked;
        const help = editor.querySelector('[data-description-source-help]');
        const previewBody = editor.querySelector('[data-description-preview-body]');
        const sync = () => {
            if (!wasStandard) customText = ownText.value;
            const assigned = Array.from(form.querySelectorAll('[name="sport_guids"]:checked')).map(input => input.value);
            const templates = Array.from(editor.querySelectorAll('[data-description-defaults]'));
            const available = assigned.filter(guid => templates.some(template =>
                template.dataset.descriptionDefaults === guid && template.content.textContent.trim()));
            standardMode.disabled = !available.length;
            editor.querySelector('[data-description-standard-label]').classList.toggle('text-muted', standardMode.disabled);
            editor.querySelector('[data-description-availability]').hidden = !standardMode.disabled;
            if (standardMode.disabled) {
                standardMode.checked = false;
                customMode.checked = true;
            }
            const standard = standardMode.checked;
            Array.from(select.options).forEach(option => {
                if (option.value) {
                    option.hidden = !assigned.includes(option.value);
                    option.disabled = !available.includes(option.value);
                }
            });
            if (select.value && !available.includes(select.value)) select.value = '';
            if (available.length === 1 && !select.value) select.value = available[0];
            standardPanel.hidden = !standard;
            select.disabled = !standard;
            ownText.readOnly = standard;
            help.textContent = assigned.length ? 'Only ticked sports with a standard description can be chosen.' : 'Tick a sport above first.';
            select.setCustomValidity(standard && !select.value
                ? 'Choose the sport whose standard description to use, or choose to write your own.' : '');
            const defaults = Array.from(editor.querySelectorAll('[data-description-defaults]'))
                .find(template => template.dataset.descriptionDefaults === select.value)?.content.textContent || '';
            if (standard) ownText.value = defaults;
            else if (wasStandard) ownText.value = customText ?? ownText.value;
            wasStandard = standard;
            editor.querySelector('[data-description-state]').textContent = standard
                ? 'Standard description: choose Customise to edit a course-specific copy.'
                : 'Customised description: changes to the sport default will not replace this text.';
            editor.querySelector('[data-description-reset]').hidden = standard || !select.value;
            previewBody.innerHTML = ownText.value.trim()
                ? `<div style="white-space: pre-wrap;">${formatDescription(ownText.value)}</div>`
                : '<p class="text-muted mb-0">No description yet.</p>';
        };
        editor.addEventListener('click', event => {
            const button = event.target.closest('[data-description-reset]');
            if (!button) return;
            if (standardMode.disabled) return;
            standardMode.checked = true;
            customMode.checked = false;
            standardMode.dispatchEvent(new Event('change', { bubbles: true }));
            ownText.focus();
        });
        editor.addEventListener('input', sync);
        editor.addEventListener('change', sync);
        form.addEventListener('reset', () => queueMicrotask(() => {
            wasStandard = standardMode.checked;
            customText = customMode.checked ? ownText.value : null;
            sync();
        }));
        form.querySelectorAll('[name="sport_guids"]').forEach(input => input.addEventListener('change', sync));
        sync();
    });
    document.querySelectorAll('[data-formatted-description]').forEach(editor => {
        if (editor.dataset.initialized) return;
        editor.dataset.initialized = 'true';
        const text = editor.querySelector('textarea');
        const preview = editor.querySelector('[data-formatted-description-preview]');
        const sync = () => {
            preview.innerHTML = `<div style="white-space: pre-wrap;">${formatDescription(text.value)}</div>`;
        };
        text.addEventListener('input', sync);
        text.form.addEventListener('reset', () => queueMicrotask(sync));
        sync();
    });
    document.querySelectorAll('[data-run-mode]').forEach(select => {
        if (select.dataset.initialized) return;
        select.dataset.initialized = 'true';
        const sync = () => {
            const weekly = select.form.querySelector('[data-run-weekly]');
            const individual = select.form.querySelector('[data-run-individual]');
            weekly.hidden = weekly.disabled = select.value !== 'weekly';
            individual.hidden = individual.disabled = select.value !== 'individual';
            weekly.querySelectorAll('input, select').forEach(input => { input.required = !weekly.disabled; });
            individual.querySelector('textarea').required = !individual.disabled;
        };
        select.addEventListener('change', sync);
        sync();
    });
    document.querySelectorAll('form[method="POST"]').forEach(form => {
        if (entries.some(entry => entry.form === form)) return;
        if ((!new URL(form.action).pathname.startsWith('/admin/') && !form.hasAttribute('data-profile-editor')) ||
            form.matches('[data-booking-form], [data-cancel-booking]') ||
            !form.querySelector('input:not([type="hidden"]):not([type="submit"]), select, textarea, [data-description-sections]')) return;
        if (!form.id) {
            const identity = Array.from(form.querySelectorAll('input[type="hidden"]'))
                .filter(field => field.name === 'guid' || field.name.endsWith('_guid'))
                .map(field => field.value).join('-');
            const action = form.querySelector('button[type="submit"]');
            const decision = action?.name ? `${action.name}-${action.value}` : '';
            form.id = `admin-editor-${new URL(form.action).pathname.replaceAll('/', '-')}-${identity}-${decision}`;
        }
        const panel = form.closest('[data-edit-panel]');
        let toggle = panel ? document.querySelector(`[data-edit-toggle][aria-controls="${panel.id}"]`) : null;
        let details = null;
        const context = form.closest('article, li, section, tr');
        const heading = context?.querySelector('h2, h3, legend, th');
        const submitter = form.querySelector('button[type="submit"]:not([form])');
        const name = form.querySelector('[name="name"]')?.value;
        const legend = form.querySelector('legend')?.textContent.trim();
        const label = form.dataset.editorLabel || [heading?.textContent.trim(), name || legend || submitter?.textContent.trim()]
            .filter(Boolean).join(' - ') || 'Admin form';
        if (!panel && !form.hasAttribute('data-editor-inline')) {
            const existingDetails = form.parentElement.tagName === 'DETAILS' &&
                (!form.parentElement.hasAttribute('data-sport-faq-details') || form.parentElement.hasAttribute('data-editor-disclosure')) &&
                (form.parentElement.hasAttribute('data-editor-disclosure') || form.parentElement.querySelectorAll('form').length === 1)
                ? form.parentElement : null;
            details = existingDetails || document.createElement('details');
            toggle = existingDetails?.querySelector(':scope > summary') || document.createElement('summary');
            const actionLabel = submitter?.textContent.trim() || 'Edit';
            const editLabel = /^Save\b/i.test(actionLabel) ? actionLabel.replace(/^Save\b/i, 'Edit') : actionLabel;
            if (!details.hasAttribute('data-editor-disclosure')) {
                toggle.classList.add('btn', 'btn-outline-secondary', 'btn-sm', 'mb-2');
                toggle.textContent = form.dataset.editorLabel || `${form.action.endsWith('/update') ? 'Edit' : editLabel}${name ? ' ' + name : legend ? ' - ' + legend : ''}`;
                toggle.setAttribute('aria-label', `Open editor: ${label}`);
            }
            if (/^Save\b/i.test(actionLabel) && form.dataset.editorPreview !== 'false') {
                const preview = document.createElement('p');
                preview.className = 'small text-muted mb-2';
                const monthFields = form.querySelectorAll('[name="allowed_months"]');
                if (monthFields.length) {
                    preview.textContent = Array.from(monthFields).filter(field => field.checked)
                        .map(field => field.closest('label').textContent.trim()).join(', ') || 'No booking months enabled';
                } else {
                    preview.textContent = Array.from(form.elements)
                        .filter(field => field.name && !field.disabled && !['hidden', 'submit', 'button', 'checkbox', 'file'].includes(field.type))
                        .slice(0, 3).map(field => field.tagName === 'SELECT'
                            ? field.selectedOptions[0]?.textContent.trim() : field.value).join(' / ');
                }
                form.before(preview);
            }
            if (!existingDetails) {
                form.before(details);
                details.append(toggle, form);
            }
        }
        const status = document.createElement('output');
        status.className = 'admin-editor-status output-inline small font-weight-bold';
        status.setAttribute('aria-live', 'polite');
        const error = document.createElement('div');
        error.className = 'alert alert-danger w-100';
        error.setAttribute('role', 'alert');
        error.tabIndex = -1;
        error.hidden = true;
        form.prepend(error);
        form.append(status);
        if (!form.querySelector('[data-cancel-edit]') && !form.hasAttribute('data-editor-inline')) {
            const cancel = document.createElement('button');
            cancel.type = 'button';
            cancel.className = 'btn btn-outline-secondary btn-sm ml-2';
            cancel.textContent = 'Cancel';
            cancel.setAttribute('data-cancel-edit', '');
            submitter?.after(cancel);
        }
        const entry = { form, panel, toggle, details, status, error, label, baseline: snapshot(form) };
        entries.push(entry);
        close(entry);
        if (form.hasAttribute('data-editor-inline')) {
            form.addEventListener('focusin', () => {
                if (active !== entry) guard({ kind: 'editor', entry });
            });
        }
        form.addEventListener('input', () => update(entry));
        form.addEventListener('change', () => update(entry));
    });
    }
    initializeEditors();

    document.addEventListener('click', event => {
        if (saving) {
            event.preventDefault();
            event.stopImmediatePropagation();
            return;
        }
        const entry = entries.find(item => item.toggle?.contains(event.target));
        if (entry) {
            event.preventDefault();
            event.stopImmediatePropagation();
            // An open card whose nested editor (e.g. a course run) is active collapses rather than switching editors
            guard(entry.details?.open && active !== entry ? { kind: 'collapse', entry }
                : { kind: active === entry ? 'close' : 'editor', entry });
            return;
        }
        const cancel = event.target.closest('[data-cancel-edit]');
        if (cancel) {
            const owner = entries.find(item => item.form.contains(cancel));
            if (!owner) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            if (active !== owner) active = owner;
            if (cancel.hasAttribute('data-cancel-immediate')) {
                reset(owner);
                proceed({ kind: 'close' });
                return;
            }
            guard({ kind: 'close' });
            return;
        }
        const summary = event.target.closest('summary');
        if (summary?.parentElement.matches('[data-course-runs-disclosure]') && summary.parentElement.open &&
            active && summary.parentElement.contains(active.form) && dirty(active)) {
            event.preventDefault();
            guard({ kind: 'faq-disclosure', details: summary.parentElement, open: false });
            return;
        }
        if (summary?.parentElement.matches('[data-sport-faq-details], [data-sport-details], [data-sport-section-details]') && active && dirty(active)) {
            event.preventDefault();
            guard({ kind: 'faq-disclosure', details: summary.parentElement, open: !summary.parentElement.open });
            return;
        }
        if (summary && active && summary.parentElement.contains(active.form) && summary.parentElement.open && dirty(active)) {
            event.preventDefault();
            guard({ kind: 'close' });
            return;
        }
        const link = event.target.closest('a[href]');
        if (link && !event.ctrlKey && !event.metaKey && !event.shiftKey && !event.altKey &&
            event.button === 0 && link.target !== '_blank' && !link.hasAttribute('download') &&
            active && dirty(active)) {
            event.preventDefault();
            guard({ kind: 'navigate', url: link.href });
        }
    }, true);

    document.addEventListener('submit', event => {
        const form = event.target;
        if (bypassSubmit === form) return;
        if (saving) {
            event.preventDefault();
            event.stopImmediatePropagation();
        } else if (active && active.form !== form && dirty(active)) {
            event.preventDefault();
            event.stopImmediatePropagation();
            guard({ kind: 'submit', form, submitter: event.submitter });
        }
    }, true);

    document.addEventListener('submit', event => {
        if (event.defaultPrevented) return;
        const form = event.target;
        const faqDelete = form.matches('form[action="/admin/courses/faqs/destroy"]');
        if (faqDelete || form.matches('form[action="/admin/sports/course-sections/destroy"]')) {
            event.preventDefault();
            const type = faqDelete ? 'faq' : 'section';
            const panel = form.closest(faqDelete ? '[data-sport-faq-details]' : '[data-sport-section-details]');
            const error = panel.querySelector(`[data-${type}-delete-error]`);
            const buttons = Array.from(form.elements).filter(field => field.tagName === 'BUTTON');
            saving = true;
            buttons.forEach(button => { button.disabled = true; });
            form.setAttribute('aria-busy', 'true');
            error.hidden = true;
            void (async () => {
                try {
                    const response = await fetch(form.action, { method: 'POST', body: new URLSearchParams(new FormData(form)) });
                    const destination = new URL(response.url);
                    if (!response.ok || destination.pathname !== '/admin/sports' ||
                        destination.searchParams.get('admin_saved') !== (faqDelete ? '1' : 'sport-updated')) {
                        throw new Error(`The ${type} deletion could not be confirmed. Check your session and the list before retrying.`);
                    }
                    await refreshSections(form, response, type);
                } catch (problem) {
                    console.error(`Unable to delete ${type}:`, problem);
                    error.textContent = problem instanceof TypeError
                        ? 'The deletion could not be confirmed because of a connection problem. Check the list before retrying.'
                        : problem.message;
                    error.hidden = false;
                    error.focus();
                } finally {
                    saving = false;
                    buttons.forEach(button => { button.disabled = false; });
                    form.removeAttribute('aria-busy');
                }
            })();
            return;
        }
        if (form.matches('form[action="/admin/facilities/destroy"]')) {
            const name = form.dataset.facilityDeleteName;
            if (!window.confirm(`Delete facility "${name}"? This permanently removes the facility, its bookings, booking resources and options, sport assignments, and course runs and sessions at this location. Shared course details and runs at other facilities are kept. This does not issue refunds and cannot be undone. Select Cancel to keep this facility.`)) {
                event.preventDefault();
                form.querySelector('button[type="submit"]').focus({ preventScroll: true });
                return;
            }
        }
        const facilityDelete = form.matches('form[action="/admin/facilities/destroy"]') && form.closest('[data-facilities-directory]');
        const sportDelete = form.matches('form[action="/admin/sports/destroy"]') && form.closest('[data-sports-directory]');
        const templateDelete = form.matches('form[action="/admin/opening-hours/destroy"]') && form.closest('[data-templates-directory]');
        const profileDelete = form.matches('form[action="/admin/profiles/destroy"]') && form.closest('[data-profiles-directory]');
        const directoryDelete = facilityDelete || sportDelete || templateDelete || profileDelete;
        const runDelete = form.matches('form[action="/admin/courses/runs/destroy"]') && form.closest('[data-course-facility]');
        if (directoryDelete || runDelete || (form.matches('form[action="/admin/courses/destroy"]') && form.closest('[data-course-facility]'))) {
            event.preventDefault();
            if (form.matches('form[action="/admin/courses/destroy"]')) {
                const name = form.closest('[data-course-guid]').dataset.courseName;
                if (!window.confirm(`Delete course "${name}"? This permanently removes the course and all its runs and sessions at every facility. Facilities, sports and their shared descriptions and FAQs are kept. This does not issue refunds and cannot be undone. Select Cancel to keep this course.`)) {
                    form.querySelector('button[type="submit"]').focus({ preventScroll: true });
                    return;
                }
            }
            if (runDelete && !window.confirm(form.dataset.runDeleteConfirm)) return;
            if (sportDelete) {
                const name = form.closest('[data-sport-guid]').dataset.sportName;
                if (!window.confirm(`Delete sport "${name}"? This permanently removes the sport, its standard course description, FAQs and facility assignments. Sports assigned to courses cannot be deleted. Select Cancel to keep this sport.`)) {
                    form.querySelector('button[type="submit"]').focus({ preventScroll: true });
                    return;
                }
            }
            const button = form.querySelector('button[type="submit"]');
            const card = directoryDelete || form.closest('[data-course-facility]');
            const type = facilityDelete ? 'facility' : sportDelete ? 'sport' : templateDelete ? 'template' : profileDelete ? 'profile' : 'course';
            const error = card.querySelector(`[data-${type}-error]`);
            const label = button.textContent;
            saving = true;
            button.disabled = true;
            button.textContent = 'Deleting...';
            form.setAttribute('aria-busy', 'true');
            error.hidden = true;
            void (async () => {
                try {
                    const response = await fetch(form.action, { method: 'POST', body: new URLSearchParams(new FormData(form)) });
                    if (runDelete && response.status === 409) {
                        const problem = await response.json();
                        throw new Error(problem.error || 'This run cannot be deleted.');
                    }
                    const destination = new URL(response.url);
                    if (!response.ok || destination.pathname !== (facilityDelete ? '/admin/facilities' : sportDelete ? '/admin/sports' : templateDelete ? '/admin/opening-hours' : profileDelete ? '/admin/profiles' : '/admin/courses') ||
                        (!directoryDelete && destination.searchParams.get('admin_saved') !== (runDelete ? '1' : 'course-deleted'))) {
                        throw new Error('The deletion could not be confirmed. Check your session and the directory before retrying.');
                    }
                    if (directoryDelete) await refreshDirectory(form, response, type);
                    else await refreshCourses(form, response);
                } catch (problem) {
                    console.error(`Unable to delete ${type}`, problem);
                    error.textContent = problem instanceof TypeError
                        ? 'The deletion could not be confirmed because of a connection problem. Check the directory before retrying.'
                        : problem.message;
                    error.hidden = false;
                    error.focus();
                } finally {
                    saving = false;
                    button.disabled = false;
                    button.textContent = label;
                    form.removeAttribute('aria-busy');
                }
            })();
            return;
        }
        const entry = entries.find(item => item.form === event.target);
        if (!entry) return;
        event.preventDefault();
        const action = submitContinuation;
        const courseForm = Boolean(entry.form.closest('[data-course-facility]'));
        void (async () => {
            const location = await save(entry, event.submitter);
            if (!location) return;
            if (entry.form.matches('form[action="/admin/courses/faqs/save"], form[action="/admin/sports/course-defaults"], form[action="/admin/sports/update"]')) {
                finishTextSave(entry);
                if (action) proceed(action);
                return;
            }
            if (entry.form.hasAttribute('data-profile-editor')) {
                if (action) proceed(action);
                else proceed({ kind: 'close' });
                return;
            }
            if (courseForm || entry.form.matches('[data-faq-add], [data-faq-edit], [data-faq-move]')) {
                if (action) proceed(action);
                return;
            }
            if (action?.kind === 'submit') proceed(action);
            else if (action) proceed(action, location);
            else proceed({ kind: 'close' }, location);
        })();
    });

    dialog.querySelector('[data-unsaved-keep]').addEventListener('click', dismiss);
    dialog.addEventListener('cancel', event => { event.preventDefault(); dismiss(); });
    dialog.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
            event.preventDefault();
            dismiss();
        }
    });
    dialog.querySelector('[data-unsaved-discard]').addEventListener('click', () => {
        const action = continuation;
        reset(active);
        dismiss();
        proceed(action);
    });
    saveChoice.addEventListener('click', () => {
        const action = continuation;
        const entry = active;
        dismiss();
        const submitter = entry.form.querySelector('button[type="submit"]:not([form])');
        submitContinuation = action;
        entry.form.requestSubmit(submitter || undefined);
        submitContinuation = null;
    });

    window.addEventListener('beforeunload', event => {
        if (!leaving && (saving || entries.some(dirty))) {
            event.preventDefault();
            event.returnValue = '';
        }
    });
    const savedSectionPanel = document.getElementById(pageUrl.hash.slice(1));
    if (savedSectionPanel?.matches('[data-sport-section-details]')) {
        savedSectionPanel.open = true;
        savedSectionPanel.closest('[data-sport-details]').open = true;
        const addedCard = Array.from(savedSectionPanel.querySelectorAll('[data-course-section-card]'))
            .find(card => card.dataset.courseSectionCard === createdSectionId);
        if (addedCard) highlightAddedCard(addedCard);
    }
    const resume = entries.find(entry => '#' + entry.form.id === window.location.hash);
    if (resume) {
        open(resume);
        if (resume.form.hasAttribute('data-editor-success-inline')) {
            const notice = document.querySelector('[data-admin-save-confirmation]');
            if (notice) {
                resume.form.closest('[data-course-facility]').querySelector('[data-course-add-feedback]').append(notice);
                notice.classList.add('mb-0', 'py-1', 'px-2', 'small');
                resetNoticeFade(notice, successKey === 'course-created');
            }
            window.addEventListener('load', () => {
                resume.form.querySelector('input:not([type="hidden"])')?.focus({ preventScroll: true });
                (notice || resume.toggle).scrollIntoView({ block: 'start' });
            }, { once: true });
        }
        resume.toggle.scrollIntoView({ block: 'center' });
    }
});
</script>
