<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Court bookings | <%= siteTitle %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
    <%- include('partials/booking-flow-styles') %>
    <style>
        body { color: #0b0c0c; background: #f2f5f9; }
        a { color: #003e90; }
        .site-bar { background: #fff; border-bottom: 0.6rem solid #ffde02; }
        .brand-logo { height: 2rem; width: auto; max-width: 12rem; }
        .page-head { background: #113255; color: #fff; padding: 2.5rem 0; }
        .page-head a { color: #fff; }
        .panel { background: #fff; border: 1px solid #b1b4b6; border-bottom: 0.4rem solid #113255; padding: 1.5rem; margin-bottom: 2rem; }
        .booking-form { padding: 1rem; }
        .booking-form > h2, .booking-form > p, .booking-form .facility-picker,
        .booking-form [data-facility-panel] > p { margin-bottom: 0.5rem !important; }
        .booking-form label { margin-bottom: 0.25rem; }
        .booking-form .booking-calendar { padding: 0.75rem !important; }
        .booking-form .booking-calendar-header { margin-bottom: 0.5rem !important; }
        .booking-form .booking-calendar-day > h3 { margin-bottom: 0.5rem !important; }
        .booking-form [data-calendar-slots], .booking-form [data-pending-list] { margin-bottom: 0.5rem !important; }
        .booking-form [data-pending-list] .list-group-item { padding-top: 0.25rem !important; padding-bottom: 0.25rem !important; }
        .booking-form button { min-height: 48px; min-width: 48px; }
        .booking-calendar-slot { margin-top: 0 !important; margin-bottom: 0 !important; }
        .booking-calendar-slot + .booking-calendar-slot { border-top-width: 0; }
        .court-space-picker { flex: 1 1 20rem; min-width: 0; }
        .facility-picker label, .court-space-picker label { display: block; font-size: 1.25rem; font-weight: 700; }
        .facility-picker select, .court-space-picker select { font-weight: 600; border: 2px solid #113255; }
        .text-muted { color: #505a5f !important; }
    </style>
    <%- include('partials/resident-banner-styles') %>
</head>

<body>
    <%- include('partials/cookie-banner') %>
    <div class="site-bar">
        <div class="container py-3 d-md-flex justify-content-between align-items-center">
            <a href="/"><% if (hasLogo) { %><img class="brand-logo" src="/site-logo" alt="<%= siteTitle %> logo"><% } else { %><%= siteTitle %><% } %></a>
            <%- include('partials/navigation') %>
        </div>
    </div>
    <header class="page-head">
        <div class="container">
            <%- include('partials/basket-button') %>
            <p class="mb-2"><a href="/">&larr; Back to home</a></p>
            <h1 class="mb-2">Court bookings</h1>
            <p class="lead mb-0">Choose an available court or space and book a time.</p>
        </div>
    </header>
    <%- include('partials/customer-navigation') %>
    <main class="container pb-5">
        <p class="mt-4"><a href="/courses">Looking to book a course? Browse course bookings.</a> <span class="mx-2">|</span> <a href="/bookings">View all my bookings</a></p>
        <%- include('partials/booking-messages') %>
        <%- include('partials/court-booking-form') %>
    </main>
    <%- include('partials/booking-flow-script') %>
</body>

</html>
