<div data-description-sections>
    <input type="hidden" name="<%= field %>" value="<%= JSON.stringify(sections || []) %>">
    <p class="small text-muted">Add, remove or reorder sections. Headings are optional. Text supports paired &lt;bold&gt;, &lt;ul&gt; (underline), &lt;bullet&gt; and &lt;email&gt; tags.</p>
    <div data-section-rows></div>
    <div class="d-flex flex-wrap align-items-center mb-3" style="gap: 0.5rem;">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-section-add>Add section</button>
        <% if (field === 'course_description_sections') { %>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-cancel-edit>Cancel</button>
            <button class="btn btn-primary btn-sm" type="submit">Save course defaults</button>
        <% } %>
    </div>
</div>
