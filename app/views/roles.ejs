<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roles | ActiveHub</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <%- include('partials/accessibility-styles') %>
</head>

<body class="bg-light">
    <main class="container py-5">
        <header class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">ActiveHub</p>
                <h1 class="h2 mb-1">Roles</h1>
                <p class="text-muted mb-0">Create roles and choose what each role is responsible for</p>
            </div>
            <%- include('partials/navigation') %>
        </header>

        <p class="alert alert-info small" role="note">
            The admin area is currently open to Administrators only, so responsibilities don't yet change what a role can reach.
            They are saved now and will apply to features outside the admin area as they are added.
        </p>

        <% const messages = {
            'invalid-role': 'Enter a role name (up to 60 characters) and choose only listed responsibilities.',
            'duplicate-role': 'A role with that name already exists.',
            'system-role': 'The Administrator role has every responsibility and cannot be edited or deleted.',
            'role-in-use': 'This role is assigned to profiles. Move those profiles to another role before deleting it.'
        }; %>
        <% if (error && messages[error]) { %>
            <div class="alert alert-danger" role="alert"><%= messages[error] %></div>
        <% } %>

        <% const renderPermissions = (idPrefix, selected, locked) => { %>
            <fieldset class="form-group">
                <legend class="h6">Responsibilities</legend>
                <% if (locked) { %>
                    <p class="small text-muted">The Administrator role always has every responsibility.</p>
                <% } %>
                <div class="form-row">
                    <% permissions.forEach(permission => { %>
                        <div class="col-md-6 mb-2">
                            <div class="custom-control custom-checkbox">
                                <input class="custom-control-input" type="checkbox" id="<%= idPrefix %>-<%= permission.key %>" name="permissions" value="<%= permission.key %>"<%= selected.includes(permission.key) ? ' checked' : '' %><%= locked ? ' disabled' : '' %>>
                                <label class="custom-control-label" for="<%= idPrefix %>-<%= permission.key %>"><%= permission.label %></label>
                                <small class="form-text text-muted mt-0"><%= permission.description %></small>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </fieldset>
        <% }; %>

        <section class="mb-3" aria-labelledby="add-role-heading">
            <div class="bg-white border rounded shadow-sm p-3">
                <h2 id="add-role-heading" class="h5 mb-2">Add role</h2>
                <form method="POST" action="/admin/roles">
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="role-name">Name</label>
                            <input class="form-control" id="role-name" name="name" type="text" maxlength="60" required>
                        </div>
                        <div class="form-group col-md-8">
                            <label for="role-description">Description <span class="text-muted">(optional)</span></label>
                            <input class="form-control" id="role-description" name="description" type="text" maxlength="300">
                        </div>
                    </div>
                    <% renderPermissions('new-role', [], false); %>
                    <button class="btn btn-primary" type="submit">Add role</button>
                </form>
            </div>
        </section>

        <section aria-labelledby="roles-list-heading">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 id="roles-list-heading" class="h5 mb-0">Existing roles</h2>
                <span class="badge badge-secondary"><%= roles.length %></span>
            </div>
            <article class="bg-white border rounded shadow-sm p-4 mb-3">
                <ul class="list-group list-group-flush">
                    <% roles.forEach(role => { const locked = role.is_system; %>
                        <li class="list-group-item px-0">
                            <div class="d-flex flex-wrap justify-content-between align-items-center" style="row-gap: 1rem;">
                                <div class="mr-3">
                                    <span class="text-break"><%= role.name %></span>
                                    <span class="badge badge-secondary ml-1"><%= role.member_count %> profile<%= role.member_count === 1 ? '' : 's' %></span>
                                    <% if (role.description) { %><p class="text-muted small mb-1 text-break"><%= role.description %></p><% } %>
                                    <p class="small mb-0">
                                        <% if (role.permissions.length) { %>
                                            <% role.permissions.forEach(key => { const permission = permissions.find(item => item.key === key); %>
                                                <span class="badge badge-light border"><%= permission ? permission.label : key %></span>
                                            <% }); %>
                                        <% } else { %>
                                            <span class="text-muted">No administration responsibilities</span>
                                        <% } %>
                                    </p>
                                </div>
                                <div class="d-flex align-items-center flex-shrink-0">
                                    <% if (!role.is_system) { %>
                                    <button class="btn btn-outline-secondary btn-sm mr-2" type="button" data-edit-toggle aria-expanded="false" aria-controls="edit-role-<%= role.guid %>" aria-label="Edit <%= role.name %>">Edit</button>
                                    <% } %>
                                    <% if (!role.is_system) { %>
                                    <form method="POST" action="/admin/roles/destroy">
                                        <input type="hidden" name="guid" value="<%= role.guid %>">
                                        <button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Delete <%= role.name %>">Delete</button>
                                    </form>
                                    <% } %>
                                </div>
                            </div>
                            <% if (!role.is_system) { %>
                            <div id="edit-role-<%= role.guid %>" data-edit-panel hidden>
                                <form class="mt-3 p-3 border rounded" method="POST" action="/admin/roles/update">
                                    <input type="hidden" name="guid" value="<%= role.guid %>">
                                    <div class="form-group">
                                        <label for="edit-role-name-<%= role.guid %>">Name</label>
                                        <input class="form-control" id="edit-role-name-<%= role.guid %>" name="name" type="text" maxlength="60" value="<%= role.name %>" required<%= locked ? ' readonly' : '' %>>
                                    </div>
                                    <div class="form-group">
                                        <label for="edit-role-description-<%= role.guid %>">Description</label>
                                        <input class="form-control" id="edit-role-description-<%= role.guid %>" name="description" type="text" maxlength="300" value="<%= role.description || '' %>">
                                    </div>
                                    <% renderPermissions(`edit-${role.guid}`, role.permissions, locked); %>
                                    <button class="btn btn-primary btn-sm" type="submit">Save changes</button>
                                    <button class="btn btn-outline-secondary btn-sm ml-1" type="button" data-cancel-edit>Cancel</button>
                                </form>
                            </div>
                            <% } %>
                        </li>
                    <% }); %>
                </ul>
            </article>
        </section>
    </main>
</body>

</html>
