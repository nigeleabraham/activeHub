<div class="form-group">
        <div class="d-flex align-items-center mb-2" style="height: 2.5rem; gap: 0.75rem;">
            <label class="mb-0" for="<%= prefix %>-question">Question</label>
            <div class="flex-grow-1" data-faq-feedback-slot style="min-width: 0; height: 2.5rem; overflow: auto;">
                <div class="alert alert-success py-1 px-2 small mb-0" data-admin-save-confirmation data-faq-feedback role="status" aria-live="polite" hidden></div>
            </div>
        </div>
    <input class="form-control" id="<%= prefix %>-question" name="question" maxlength="300" value="<%= faq?.question || '' %>" required>
</div>
<div class="form-group">
    <label for="<%= prefix %>-answer">Answer</label>
    <textarea class="form-control" id="<%= prefix %>-answer" name="answer" maxlength="10000" rows="3" required aria-describedby="<%= prefix %>-answer-hint"><%= faq?.answer || '' %></textarea>
    <small class="form-text text-muted" id="<%= prefix %>-answer-hint">Use &lt;bold&gt;highlighted text&lt;/bold&gt; for dark-blue text (not bold), &lt;ul&gt;underlined text&lt;/ul&gt; for underline, &lt;bullet&gt;list item&lt;/bullet&gt; for each bullet point, and &lt;email&gt;name@example.com&lt;/email&gt; for a clickable email address. Line breaks are preserved. Other HTML and Markdown markers are displayed as plain text.</small>
</div>
